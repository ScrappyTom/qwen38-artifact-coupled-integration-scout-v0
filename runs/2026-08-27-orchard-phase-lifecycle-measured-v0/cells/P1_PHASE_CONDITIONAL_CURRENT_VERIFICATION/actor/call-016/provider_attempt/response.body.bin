ESULT-020\\\"\")\nresponse-format-4-result-id-kv ::= \"\\\"result_id\\\"\" space \":\" space response-format-4-result-id\nresponse-format-5 ::= \"{\" space response-format-5-action-kv space \"}\"\nresponse-format-5-action ::= \"\\\"submit\\\"\"\nresponse-format-5-action-kv ::= \"\\\"action\\\"\" space \":\" space response-format-5-action\nroot ::= \"<|im_start|>assistant\\n\" (\"<think>\" space until-5 (\"</think>\" | ))? space response-format\nspace ::= | \" \" | \"\\n\"{1,2} [ \\t]{0,20}\nstring ::= \"\\\"\" char* \"\\\"\"\nuntil-5 ::= | [<] until-5-01 | [^<] until-5\nuntil-5-01 ::= | [<] until-5-01 | [/] until-5-02 | [t] until-5-09 | [^/<t] until-5\nuntil-5-02 ::= | [<] until-5-01 | [t] until-5-03 | [^<t] until-5\nuntil-5-03 ::= | [<] until-5-01 | [h] until-5-04 | [^<h] until-5\nuntil-5-04 ::= | [<] until-5-01 | [i] until-5-05 | [^<i] until-5\nuntil-5-05 ::= | [<] until-5-01 | [n] until-5-06 | [^<n] until-5\nuntil-5-06 ::= | [<] until-5-01 | [k] until-5-07 | [^<k] until-5\nuntil-5-07 ::= | [<] until-5-01 | [^<>] until-5\nuntil-5-09 ::= | [<] until-5-01 | [o] until-5-10 | [^<o] until-5\nuntil-5-10 ::= | [<] until-5-01 | [o] until-5-11 | [^<o] until-5\nuntil-5-11 ::= | [<] until-5-01 | [l] until-5-12 | [^<l] until-5\nuntil-5-12 ::= | [<] until-5-01 | [_] until-5-13 | [^<_] until-5\nuntil-5-13 ::= | [<] until-5-01 | [c] until-5-14 | [^<c] until-5\nuntil-5-14 ::= | [<] until-5-01 | [a] until-5-15 | [^<a] until-5\nuntil-5-15 ::= | [<] until-5-01 | [l] until-5-16 | [^<l] until-5\nuntil-5-16 ::= | [<] until-5-01 | [l] until-5-17 | [^<l] until-5\nuntil-5-17 ::= | [<] until-5-01 | [^<>] until-5\n","grammar_lazy":false,"grammar_triggers":[],"preserved_tokens":[248058,248059,248068,248069],"chat_format":"peg-native","reasoning_format":"deepseek","reasoning_in_content":false,"generation_prompt":"<|im_start|>assistant\n<think>\n\n</think>\n\n","samplers":["penalties","dry","top_n_sigma","top_k","typ_p","top_p","min_p","xtc","temperature"],"speculative.types":"none","timings_per_token":false,"post_sampling_probs":false,"backend_sampling":false,"lora":[]},"prompt":"<|im_start|>system\nYou are the ordinary actor in a bounded biologics-restart decision system.\n\nUse exact task actions to inspect evidence, build the exact task artifacts,\ncheck the current candidate, repair real blockers, and propose submission only\nwhen the current candidate has a current passing check. Exact sources, effects,\nchecks, and history remain externally custodied and reopenable.\n\nAny semantic scaffold is lossy, incomplete, non-authoritative, and source-bound.\nUse it as provisional construction support, never as release, restart, or\nclosure authority. Preserve exact values, units, signs, locations, modalities,\nversions, qualifications, and authority boundaries. A candidate mutation makes\nprior checks stale until the changed candidate is checked.\n\nReturn exactly one declared JSON action and no prose.<|im_end|>\n<|im_start|>user\n# Orchard Biologics Restart Decision Task\n\nProduce two exact, source-grounded work products for the synthetic Orchard\nbiologics facility:\n\n1. `EVIDENCE_INTEGRATION_LEDGER.md`, beginning with exactly\n   `# Orchard Evidence and Decision Matrix`.\n2. `BOUNDED_AGENT_ARCHITECTURE_DECISION.md`, beginning with exactly\n   `# Orchard Biologics Restart Decision` and containing exactly these ordered\n   level-two headings:\n\n   1. `Authority, scope, and restart states`\n   2. `Process, genealogy, and hold-time controls`\n   3. `Aseptic, analytical, and cold-chain release gates`\n   4. `Utilities, materials, staffing, and staged restart`\n   5. `Cybersecurity, telemetry, and evidence custody`\n   6. `Safety, environmental, and communication continuity`\n   7. `Execution, rollback, and contingencies`\n   8. `Verification, blockers, falsifiers, and closure`\n\nThe final decision must contain 1,400–1,900 words excluding bracketed source\ncitations and cite at least ten distinct exact source IDs. It must reconcile\nauthority, process performance, aseptic controls, cold-chain excursion,\nutilities, analytical disposition, cybersecurity, materials/staffing,\nenvironmental duties, monitoring, communications, candidate lineage, and\nindependent readiness.\n\nDo not merely list facts. Bind every action and gate to owners, prerequisites,\nobservations, current candidate/version, falsifiers, rollback, and evidence that\nretires temporary controls. Preserve exact distinctions including observations\nversus gates, alert versus action limits, installed versus usable capacity,\npercent versus probability, hours versus days, source-local authority, and\ncurrent versus stale evidence.\n\nThe task-native artifacts are exact cumulative work. Checks are candidate-bound\nmechanical feedback and do not independently authorize lot release, commercial\nrestart, or closure.<|im_end|>\n<|im_start|>user\n# Orchard bounded verification action contract\n\nReturn exactly one JSON action object and no prose.\n\nAllowed actions:\n\n```text\n{\"action\":\"patch_decision\",\"edits\":[{\"old\":\"exact unique current text\",\"new\":\"replacement text\"}]}\n{\"action\":\"run_check\"}\n{\"action\":\"read_source\",\"source_id\":\"CHARTER\",\"start_line\":1,\"end_line\":20}\n{\"action\":\"read_batch\",\"requests\":[{\"source_id\":\"CURRENT\",\"start_line\":1,\"end_line\":20},{\"source_id\":\"ASSAY\",\"start_line\":1,\"end_line\":20}]}\n{\"action\":\"reopen_exact\",\"result_id\":\"RESULT-...\"}\n{\"action\":\"submit\"}\n```\n\nUse the candidate-bound expected/observed findings. Repair with bounded exact\nedits, observe the effect, and recheck the changed candidate. A passing\nmechanical check does not itself authorize release, restart, or closure.<|im_end|>\n<|im_start|>user\n# Exact source catalog\n{\"schema\":\"architecture-source-catalog-v0\",\"sources\":[{\"line_count\":64,\"sha256\":\"6cb6875c0d4316fa8be25f0b568bd2924e571af7f2cb30e755336344339e5174\",\"size_bytes\":3964,\"source_id\":\"CHARTER\",\"title\":\"Restart authority and accountable disposition\"},{\"line_count\":64,\"sha256\":\"4afe715ed5a632f384658d45a19fda0c6f1bc5476bc24ab525c75687df9c5d46\",\"size_bytes\":3843,\"source_id\":\"CULTURE\",\"title\":\"Bioreactor state, yield, and hold-time evidence\"},{\"line_count\":64,\"sha256\":\"19a5fe9d20e744fef04763096ac79029de041a7a5b0004926e87761852415188\",\"size_bytes\":3468,\"source_id\":\"STERILE\",\"title\":\"Aseptic processing and contamination-control evidence\"},{\"line_count\":64,\"sha256\":\"19adb344c96282fbb4bac930bd01230e5d1d1d4ac513e17a22e176671be5af62\",\"size_bytes\":3994,\"source_id\":\"CHILL\",\"title\":\"Cold-chain mapping, excursion, and disposition\"},{\"line_count\":64,\"sha256\":\"12b2bcc5b451921b38d9af555f68af1d74e8673e4c037b2ec3d5ef1e6a1b0a55\",\"size_bytes\":3820,\"source_id\":\"CURRENT\",\"title\":\"Clean utilities, power, and capacity\"},{\"line_count\":64,\"sha256\":\"06b691266e9619612bfca550779938fc481d39a96385115299e737f310b306d5\",\"size_bytes\":3806,\"source_id\":\"ASSAY\",\"title\":\"Analytical results, specification, and lot disposition\"},{\"line_count\":64,\"sha256\":\"7dfea87e46a18ed29a974a3175fa0aaf0f31b817a9f7017471ed667e396786e5\",\"size_bytes\":3437,\"source_id\":\"GUARD\",\"title\":\"Control-system access, integrity, and evidence custody\"},{\"line_count\":64,\"sha256\":\"5a97d24e023016fa9921576e3584309b03359570afe41d30ad2e8f7084b5fc50\",\"size_bytes\":3505,\"source_id\":\"SUPPLY\",\"title\":\"Materials, fuel, staffing, and supplier continuity\"},{\"line_count\":64,\"sha256\":\"163e6d198789dc487419a4149aea6b41ec06976a16b57924f51e7cae80ae3d6e\",\"size_bytes\":3423,\"source_id\":\"SAFETY\",\"title\":\"Worker safety, emissions, waste, and notification\"},{\"line_count\":64,\"sha256\":\"f0c38d24fd53e1ff8350bbfd06951cf70c9ddc21ed2110829fd8e48e000d85b8\",\"size_bytes\":3755,\"source_id\":\"SIGNAL\",\"title\":\"Monitoring coverage, alerts, and latency\"},{\"line_count\":64,\"sha256\":\"32bfd24b2b40e1096b1d87dfc1ffce5867a0a07da290766d4766ccc552614860\",\"size_bytes\":4124,\"source_id\":\"COMMUNE\",\"title\":\"Workforce, regulator, and customer communications\"},{\"line_count\":64,\"sha256\":\"a89a287a5ee18083a0cf9765bd56b485a80cbe56d7ed3303ac294bcd21c25328\",\"size_bytes\":3904,\"source_id\":\"CHANGE\",\"title\":\"Candidate lineage, rollback, and configuration control\"},{\"line_count\":64,\"sha256\":\"661c0269b7146dbf1a492776fd890e3cacbd0f8cf72a2df5ec3613e9a9c9c3d9\",\"size_bytes\":3716,\"source_id\":\"REVIEW\",\"title\":\"Independent readiness review, blockers, and falsifiers\"}]}<|im_end|>\n<|im_start|>user\n# Exact current candidate\n{\"candidate_sha256\":\"074c474d71067d91040b81bea2a3ae260ad0d7f0b34322dc2f97096688db7711\",\"candidate_version\":\"candidate-v009:074c474d71067d91040b81bea2a3ae260ad0d7f0b34322dc2f97096688db7711\",\"files\":{\"BOUNDED_AGENT_ARCHITECTURE_DECISION.md\":\"a5e0fff792656e6bd882f4588c1b05d00aa25c1a17915c6946e684defb53c72d\",\"EVIDENCE_INTEGRATION_LEDGER.md\":\"68ada5d2bf4f35de9cfedd7d949544eae586fc9cf651537373897b4abe0ce33b\"},\"schema\":\"architecture-current-candidate-v0\"}\n--- exact candidate file: EVIDENCE_INTEGRATION_LEDGER.md ---\n# Orchard Evidence and Decision Matrix\n\n| Source | Domain | Key Observation | Exact Value/Unit | Candidate Binding | Staleness Trigger | Owner/Gate |\n| :--- | :--- | :--- | :--- | :--- | :--- | :--- |\n| CHARTER [6cb6875c] | Authority | Commercial restart authority | Site head only | R9/B14/F8/U11/K7 | Any version mismatch blocks closure | CHARTER/Quality Unit/Site Head |\n| CULTURE [4afe715e] | Process | Yield gate | 68% min in 2 consecutive batches | R9 (Current: 72% one batch) | Media/recipe/sensor change | REVIEW/CHARTER |\n| STERILE [19a5fe9d] | Aseptic | Media fill clearance | 3 consecutive successful runs | R9 (Current: 1 clean run) | Glove/sterilization/path change | CHARTER/Quality Unit |\n| CHILL [19adb344] | Cold-chain | Lane-4 excursion | -54°C for 22 min | R9 (Unresolved stability) | Any lane map change | ASSAY/CHARTER |\n| CURRENT [12b2bcc5] | Utilities | Generator duration | 28h emergency / 17h full load | R9/U11 | Fuel level or load regime change | CHARTER/SITE HEAD |\n| ASSAY [06b69126] | Analytical | Potency disposition | 91% (Spec: 85-115%) | R9/B14 | Genealogy or method change | QUALITY UNIT |\n| GUARD [7dfea87e] | Cybersecurity | Service account status | Disabled at 09:40 UTC | R9/K7 | Key-set or role-policy mutation | GUARD/CHARTER |\n| SUPPLY [5a97d24e] | Materials | Resin coverage | 2.6 batches (vs 4.2 days stoppers) | R9 | Inventory consumption or supplier change | CHARTER/SUPPLY OWNER |\n| SAFETY [163e6d19] | Environmental | Neutralization threshold | Stop if >0.021 mg/L at outfall | Permit N-12 | Discharge concentration change | SAFETY/CHARTER |\n| SIGNAL [f0c38d24] | Monitoring | Critical coverage | 94% (6% unobserved) | R9/U11 | Sensor removal or map change | SIGNAL/CHARTER |\n| COMMUNE [32bfd24b] | Communications | Workforce reach | 89% acknowledged (11% uncertainty) | R9 | Channel failure or message change | COMMUNE/SITE HEAD |\n| CHANGE [a89a287a] | Lineage | Current candidate | R9/B14/F8/U11/K7 | R9 | Any mutation requires recheck | CHANGE/CHARTER |\n| REVIEW [661c0269] | Readiness | Open findings | 13 total (4 aseptic, 3 utility) | R9 | New finding or unresolved blocker | REVIEW/SITE HEAD |\n\n## Falsifiers and Blockers\n1. **Aseptic Falsifier:** Any CFU > 0 in media fill stops filling immediately [STERILE].\n2. **Utility Blocker:** Stale generator-transfer evidence must be replaced with current U11 data [CURRENT, REVIEW].\n3. **Cyber Blocker:** Remote recipe deployment is blocked until GUARD validation of K7 and access logs [GUARD].\n4. **Cold-chain Blocker:** Lane-4 stability disposition remains unresolved; commercial restart is blocked [CHILL, ASSAY].\n5. **Authority Falsifier:** A successful mechanical check does not authorize lot release or commercial restart [CHARTER].\n--- exact candidate file: BOUNDED_AGENT_ARCHITECTURE_DECISION.md ---\n# Orchard Biologics Restart Decision\n\nNo restart decision has yet been constructed.\n\n## Authority, scope, and restart states\n\nThe incident lead may isolate equipment and order emergency stabilization, but only the independent quality unit may release a manufactured lot, and only the site head may authorize commercial restart after current quality, aseptic, utility, and cyber evidence is reconciled [CHARTER]. Emergency procurement does not waive validated methods, operator qualification, chain of custody, environmental permits, data-integrity controls, or deviation review [CHARTER]. A handoff is valid only when the receiving lead acknowledges the same batch genealogy (B14), fill-line configuration (F8), cold-chain map, utility state (U11), and control-system version (K7); a version mismatch blocks closure [CHARTER, CHANGE]. The current restart candidate is R9 with batch genealogy B14, fill-line configuration F8, utility map U11, and key set K7; evidence for R8 is historical unless explicitly transferred and rechecked [CHANGE]. Only the site head may authorize commercial restart after current quality, aseptic, utility, and cyber evidence is reconciled [CHARTER]. A successful mechanical check is not lot release or commercial restart authority [CHARTER]. The independent quality unit must acknowledge the same batch genealogy, fill-line configuration, cold-chain map, utility state, and control-system version before any handoff is valid [CHARTER].\n\n## Process, genealogy, and hold-time controls\n\nThe current engineering batch achieved 72 percent yield, but the restart gate requires at least 68 percent yield in two consecutive engineering batches; one 72 percent batch is insufficient [CULTURE]. Harvest hold time is limited to six hours at 2 to 8 degrees Celsius, which is distinct from the downstream twelve-hour formulated-bulk limit [CULTURE]. A media lot, inoculum, control recipe, reactor sensor, transfer path, or hold vessel change makes earlier process evidence stale for the changed candidate [CULTURE]. The latest media fill found zero contaminated units across 9,600 filled units, but clearance requires three consecutive successful media fills; one clean run is insufficient [STERILE]. The action limit is 1 CFU per cubic meter in Grade A active air, while the alert limit is 3 CFU per plate in the adjacent Grade B settle test; these locations, units, and limit types must not be interchanged [STERILE]. A glove, transfer port, sterilization cycle, filling path, viable-air method, or environmental-monitoring plan change makes earlier aseptic evidence stale [STERILE]. The observed lane-4 excursion was minus 54 degrees Celsius for twenty-two minutes, against an allowed range of minus 80 to minus 60 degrees Celsius for frozen drug substance stored at minus 70 degrees Celsius [CHILL]. This unresolved lane-4 stability disposition is a blocking finding that prevents commercial restart [REVIEW].\n\n## Aseptic, analytical, and cold-chain release gates\n\nThe clean-utility warning threshold is 81 degrees Celsius and the production stop threshold is 79 degrees Celsius [SIGNAL]. Alarm delivery latency is measured at 640 milliseconds at p95 and 1,050 milliseconds at p99 [SIGNAL]. Current monitoring coverage leaves 6 percent of critical assets unobserved, which must be reconciled before commercial restart [SIGNAL]. The recipe-signing key was not exposed and remains current under key-set K7 [GUARD]. Break-glass access expires after two hours and requires dual approval plus immutable session logging [GUARD]. Remote recipe deployment is blocked until GUARD validation of K7 and access logs confirms integrity [GUARD, REVIEW]. Analytical potency is currently 91 percent of reference, within the approved specification of 85 to 115 percent [ASSAY]. However, the unresolved lane-4 stability disposition remains a blocker for lot release and commercial restart [CHILL, ASSAY, REVIEW].\n\n## Utilities, materials, staffing, and staged restart\n\nCurrent diesel stock covers twenty-eight hours at emergency load and seventeen hours at full production load [SUPPLY]. Mutual aid provides five qualified operators beginning at 05:30 UTC with travel uncertainty of plus or minus seventy-five minutes [SUPPLY]. The hotline sustains 1,800 contacts per hour for four hours, while forecast demand is 2,400 per hour unless multilingual outbound messages reduce repeat contacts [COMMUNE]. Stale generator-transfer evidence must be replaced with current U11 data before restart authorization [CURRENT, REVIEW]. A material unauthorized solvent release requires initial notice within twenty-four hours of determination, not twenty-four minutes after detection [SAFETY]. Under permit condition N-12, discharge above 0.021 milligrams per liter at the outfall requires an immediate stop [SAFETY].\n\n## Cybersecurity, telemetry, and evidence custody\n\nThe recipe-signing key was not exposed and remains current under key-set K7 [GUARD]. Break-glass access expires after two hours and requires dual approval plus immutable session logging [GUARD]. Remote recipe deployment is blocked until GUARD validation of K7 and access logs confirms integrity [GUARD, REVIEW]. Alarm delivery latency is 640 milliseconds at p95 and 1,050 milliseconds at p99; the clean-utility warning threshold is 81 degrees Celsius and the production stop is 79 degrees [SIGNAL]. Current monitoring coverage leaves 6 percent of critical assets unobserved, which must be reconciled before commercial restart [SIGNAL, REVIEW].\n\n## Safety, environmental, and communication continuity\n\nA material unauthorized solvent release requires initial notice within twenty-four hours of determination, not twenty-four minutes after detection [SAFETY]. Under permit condition N-12, discharge above 0.021 milligrams per liter at the outfall requires an immediate stop [SAFETY]. The hotline sustains 1,800 contacts per hour for four hours, while forecast demand is 2,400 per hour unless multilingual outbound messages reduce repeat contacts [COMMUNE]. Mutual aid provides five qualified operators beginning at 05:30 UTC with travel uncertainty of plus or minus seventy-five minutes [SUPPLY].\n\n## Execution, rollback, and contingencies\n\nRollback to R8 is mechanically possible only while recipe V6 and controller firmware C13 remain compatible [CHANGE]. The current restart candidate is R9 with batch genealogy B14, fill-line configuration F8, utility map U11, and key set K7; any mutation to these identifiers invalidates prior evidence and requires recheck [CHANGE]. Stale generator-transfer evidence must be replaced with current U11 data before restart authorization [CURRENT, REVIEW]. Two missing media fills remain unresolved and block aseptic clearance [STERILE, REVIEW]. The falsifier for process performance is a yield below 68 percent in two consecutive engineering batches; the falsifier for aseptic clearance is any contaminated unit in three consecutive media fills [CULTURE, STERILE].\n\n## Verification, blockers, falsifiers, and closure\n\nThe latest independent review found thirteen open findings: four aseptic, three utility, three quality, two cyber, and one communication [REVIEW]. Blocking findings include two missing media fills, stale generator-transfer evidence, unresolved lane-4 stability disposition, and missing quality-unit acknowledgment [REVIEW]. Readiness requires current candidate-bound evidence for every blocking control, independent residual-risk review, and explicit acceptance by each authorized owner [REVIEW]. A successful mechanical check is not lot release or commercial restart authority [CHARTER]. The falsifiers are: yield below 68 percent in two consecutive batches [CULTURE], any contaminated unit in three consecutive media fills [STERILE], discharge above 0.021 milligrams per liter [SAFETY], and alarm latency exceeding p99 thresholds [SIGNAL]. Closure is blocked until all thirteen findings are resolved with current candidate-bound evidence and explicit owner acceptance [REVIEW, CHARTER].<|im_end|>\n<|im_start|>user\n# Current verification projection\n{\"current_candidate_sha256\":\"074c474d71067d91040b81bea2a3ae260ad0d7f0b34322dc2f97096688db7711\",\"current_candidate_verification_status\":\"current\",\"current_candidate_version\":\"candidate-v009:074c474d71067d91040b81bea2a3ae260ad0d7f0b34322dc2f97096688db7711\",\"current_check\":{\"blocking_requirements\":[\"R04_cold_chain: missing relation patterns: 2 | expected=-70 C set point with -80 to -60 C allowed range; lane-4 reached -54 C for 22 minutes and requires stability review. | observed=missing: (minus 70|-70).{0,100}(minus 80|-80).{0,30}(minus 60|-60) | stability review\",\"R05_utilities: missing relation patterns: 4 | expected=WFI is 82 C; every return must remain at least 80 C for three 30-minute windows; usable power is 5.4 MW versus 7.1 MW installed; generator is 3.2 MW for 28 hours. | observed=missing: 82 degrees.{0,100}80 degrees.{0,100}every return | three consecutive.{0,40}(thirty|30)-minute | 5\\\\.4 mw.{0,100}7\\\\.1 mw | 3\\\\.2 mw.{0,80}(twenty-eight|28) hours\",\"R06_quality: missing relation patterns: 2 | expected=91 percent potency is an observation within 85-115 percent; endotoxin 0.18 EU/mL is below 0.25 EU/mL; legacy 0.50 is superseded. | observed=missing: 0\\\\.18 eu.{0,100}0\\\\.25 eu | 0\\\\.50 eu.{0,80}supersed\",\"R07_cyber: missing relation patterns: 1 | expected=Service account disabled at 09:40 UTC; K7 signing key not exposed; break-glass expires after two hours with dual approval. | observed=missing: 09:40 utc\",\"R08_supply: missing relation patterns: 1 | expected=Diesel covers 28 hours at emergency load and 17 at full production; stoppers cover 4.2 days, resin 2.6 batches; five operators start 05:30 +/-75 minutes. | observed=missing: 4\\\\.2.{0,50}days.{0,100}2\\\\.6.{0,50}batches\",\"R10_observation: missing relation patterns: 1 | expected=94 percent coverage leaves six percent unobserved; 81 C is warning and 79 C stop; latency is 640 ms p95 and 1,050 ms p99. | observed=missing: 94 percent.{0,80}six percent.{0,80}unobserv\",\"R11_communications: missing relation patterns: 1 | expected=89 percent acknowledged leaves 11 percent communication uncertainty; hotline 1,800/hour for four hours versus forecast 2,400/hour. | observed=missing: 89 percent.{0,100}(eleven|11) percent.{0,80}(uncertainty|unacknowledged)\",\"decision_word_range: word_count=1075; required=1400-1900 | expected= | observed=\",\"ledger_source_breadth: 3 distinct cited sources | expected= | observed=\"],\"closure_readiness\":\"not_ready\",\"criterion_results\":[{\"criterion_id\":\"R01_authority\",\"description\":\"required relationship supported\",\"status\":\"pass\"},{\"criterion_id\":\"R02_process\",\"description\":\"required relationship supported\",\"status\":\"pass\"},{\"criterion_id\":\"R03_aseptic\",\"description\":\"required relationship supported\",\"status\":\"pass\"},{\"criterion_id\":\"R04_cold_chain\",\"description\":\"missing relation patterns: 2\",\"status\":\"fail\"},{\"criterion_id\":\"R05_utilities\",\"description\":\"missing relation patterns: 4\",\"status\":\"fail\"},{\"criterion_id\":\"R06_quality\",\"description\":\"missing relation patterns: 2\",\"status\":\"fail\"},{\"criterion_id\":\"R07_cyber\",\"description\":\"missing relation patterns: 1\",\"status\":\"fail\"},{\"criterion_id\":\"R08_supply\",\"description\":\"missing relation patterns: 1\",\"status\":\"fail\"},{\"criterion_id\":\"R09_environment\",\"description\":\"required relationship supported\",\"status\":\"pass\"},{\"criterion_id\":\"R10_observation\",\"description\":\"missing relation patterns: 1\",\"status\":\"fail\"},{\"criterion_id\":\"R11_communications\",\"description\":\"missing relation patterns: 1\",\"status\":\"fail\"},{\"criterion_id\":\"R12_currentness\",\"description\":\"required relationship supported\",\"status\":\"pass\"},{\"criterion_id\":\"aseptic_limit_reversal\",\"description\":\"no prohibited relation conversion\",\"status\":\"pass\"},{\"criterion_id\":\"clock_reve