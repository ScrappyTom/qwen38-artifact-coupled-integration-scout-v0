_id\":\"S11\",\"title\":\"Capability terrain map\"},{\"line_count\":218,\"sha256\":\"0f13778c862fa91d79406ab854fa3c67ecc213c1506a9f24b8625e6a011622a9\",\"size_bytes\":10717,\"source_id\":\"S12\",\"title\":\"Capability-terrain reconnaissance v0: program disposition\"},{\"line_count\":70,\"sha256\":\"6f9a5d30b56496cce7010b8055392f4a1f33930959d672217e83b22c189028fd\",\"size_bytes\":2276,\"source_id\":\"S13\",\"title\":\"H05 artifact-disposition reconciliation\"},{\"line_count\":131,\"sha256\":\"80fb23325bf09b9e2529ab8a2d65e81e9dca8637a6b785256814963f4be3ec95\",\"size_bytes\":6229,\"source_id\":\"S14\",\"title\":\"Next-route prior-evidence reconciliation\"}]}<|im_end|>\n<|im_start|>user\n# Exact current candidate\n{\"candidate_sha256\":\"eb63671008e22987e37ff1ebc26a8ddb29f92ec55ee1d3d1ad0d7d1d64ae181e\",\"candidate_version\":\"candidate-v000:eb63671008e22987e37ff1ebc26a8ddb29f92ec55ee1d3d1ad0d7d1d64ae181e\",\"files\":{\"BOUNDED_AGENT_ARCHITECTURE_DECISION.md\":\"7e404f49ccbf0a480d19a2854e67fd9b1d8e125c8e915f891cc99ebc62b4134f\",\"EVIDENCE_INTEGRATION_LEDGER.md\":\"d6d03dfefc533743178d8b4379544dccb0212dd637a610d93284dbc19ef0b505\"},\"schema\":\"architecture-current-candidate-v0\"}\n--- exact candidate file: EVIDENCE_INTEGRATION_LEDGER.md ---\n# Evidence Integration Ledger\n\nNo requirements have been integrated yet.\n\n--- exact candidate file: BOUNDED_AGENT_ARCHITECTURE_DECISION.md ---\n# Bounded-Agent Architecture Decision\n\nNo decision has been constructed yet.<|im_end|>\n<|im_start|>assistant\n{\"action\":\"read_batch\",\"requests\":[{\"end_line\":120,\"source_id\":\"S02\",\"start_line\":1},{\"end_line\":120,\"source_id\":\"S03\",\"start_line\":1},{\"end_line\":120,\"source_id\":\"S04\",\"start_line\":1}]}<|im_end|>\n<|im_start|>user\n{\"call_index\":1,\"candidate_sha256\":\"eb63671008e22987e37ff1ebc26a8ddb29f92ec55ee1d3d1ad0d7d1d64ae181e\",\"code\":\"batch_source_bytes_exceeded\",\"message\":\"batch exact bytes 42974 exceed 40000\",\"repaired\":false,\"schema\":\"architecture-action-rejection-v0\"}<|im_end|>\n<|im_start|>assistant\n{\"action\":\"read_batch\",\"requests\":[{\"end_line\":120,\"source_id\":\"S02\",\"start_line\":1},{\"end_line\":120,\"source_id\":\"S03\",\"start_line\":1}]}<|im_end|>\n<|im_start|>user\n{\"delivery_ordinal\":3,\"exact_result_sha256\":\"f866f4a2a8140dc24c05ea2f73722ec95f62690faca2f8fab14fe7cf31591d17\",\"exact_result_size_bytes\":12205,\"object_id\":\"batch:S02:1-120+S03:1-120\",\"object_version\":\"841c28e6b82c8eeb7d49a6f7e2641a2a4677bbc256a749eb6e8d9f73600f12b5\",\"observed_ranges\":[{\"end_line\":120,\"source_id\":\"S02\",\"start_line\":1},{\"end_line\":120,\"source_id\":\"S03\",\"start_line\":1}],\"previously_model_visible\":true,\"reopen_action\":{\"action\":\"reopen_exact\",\"result_id\":\"RESULT-002\"},\"reopen_handle\":\"result://sha256/f866f4a2a8140dc24c05ea2f73722ec95f62690faca2f8fab14fe7cf31591d17\",\"resident\":false,\"result_id\":\"RESULT-002\",\"result_kind\":\"source_observation\",\"schema_version\":\"ceiba-exact-result-receipt-v1\",\"source_id\":null,\"source_ids\":[\"S02\",\"S03\"],\"source_path\":null,\"source_sha256\":null,\"source_size_bytes\":null,\"total_source_bytes\":11711}<|im_end|>\n<|im_start|>assistant\n{\"action\":\"read_batch\",\"requests\":[{\"end_line\":120,\"source_id\":\"S04\",\"start_line\":1},{\"end_line\":80,\"source_id\":\"S08\",\"start_line\":1}]}<|im_end|>\n<|im_start|>user\n{\"delivery_ordinal\":4,\"exact_result_sha256\":\"678d1cf82ee098d176933d36ce7c14693f1006f601a7927abdf3e770d881085d\",\"exact_result_size_bytes\":35290,\"object_id\":\"batch:S04:1-120+S08:1-80\",\"object_version\":\"8ed66e2b4e4ae15d21d3b276f0009cb361c8a0c6e8c2da9969cc02775e87e67d\",\"observed_ranges\":[{\"end_line\":120,\"source_id\":\"S04\",\"start_line\":1},{\"end_line\":80,\"source_id\":\"S08\",\"start_line\":1}],\"previously_model_visible\":true,\"reopen_action\":{\"action\":\"reopen_exact\",\"result_id\":\"RESULT-003\"},\"reopen_handle\":\"result://sha256/678d1cf82ee098d176933d36ce7c14693f1006f601a7927abdf3e770d881085d\",\"resident\":false,\"result_id\":\"RESULT-003\",\"result_kind\":\"source_observation\",\"schema_version\":\"ceiba-exact-result-receipt-v1\",\"source_id\":null,\"source_ids\":[\"S04\",\"S08\"],\"source_path\":null,\"source_sha256\":null,\"source_size_bytes\":null,\"total_source_bytes\":34798}<|im_end|>\n<|im_start|>assistant\n{\"action\":\"read_source\",\"end_line\":120,\"source_id\":\"S13\",\"start_line\":1}<|im_end|>\n<|im_start|>user\n{\"call_index\":4,\"candidate_sha256\":\"eb63671008e22987e37ff1ebc26a8ddb29f92ec55ee1d3d1ad0d7d1d64ae181e\",\"code\":\"range_out_of_bounds\",\"message\":\"S13 has 70 lines\",\"repaired\":false,\"schema\":\"architecture-action-rejection-v0\"}<|im_end|>\n<|im_start|>assistant\n{\"action\":\"read_source\",\"end_line\":70,\"source_id\":\"S13\",\"start_line\":1}<|im_end|>\n<|im_start|>user\n{\"object_id\":\"source:S13:1-70\",\"object_version\":\"6f9a5d30b56496cce7010b8055392f4a1f33930959d672217e83b22c189028fd\",\"result_id\":\"RESULT-005\",\"result_kind\":\"source_observation\",\"schema\":\"ceiba-action-result-v1\"}\n--- exact result body ---\n{\"end_line\":70,\"source_id\":\"S13\",\"source_path\":\"sources/S13_H05_CORRECTION.md\",\"source_sha256\":\"6f9a5d30b56496cce7010b8055392f4a1f33930959d672217e83b22c189028fd\",\"source_size_bytes\":2276,\"start_line\":1}\n--- exact source range ---\n# H05 artifact-disposition reconciliation\n\nDate: 2026-08-22\n\n## Finding\n\nThe H05 raw behavioral contrast is valid, but its original artifact disposition\nwas wrong.\n\nThe treated actor submitted candidate ID\n`38893b4df5afc252a356ff5ab79a1dcda6330b7934a252a67d2759499eb4aac6`,\nfile SHA-256\n`888c142abcad4c3bd9081960bdb18b7402be6415c03b456033ed3c7aed134d39`.\nThose exact bytes had already been audited at construction-reentry donor commit\n`68a4b0b04c4557dcc459b42822e804f241565757` as a **strong partial** artifact.\n\nThe prior frozen table contained 12 substantive requirement groups:\n\n- 10 met;\n- apparatus-correction coverage partial; and\n- factual precision about the timing of 11 seed-42 reopens partial.\n\nThe candidate also satisfied the separate file-scope constraint. It was not a\ncomplete task artifact.\n\n## Corrected H05 interpretation\n\nThe literal sequence remains:\n\n```text\nbyte-identical control\n-> resident candidate reread\n\n169-token progress state in 464-token package\n-> admitted submit\n-> unchanged strong-partial candidate\n```\n\nThe package was behaviorally active. Its trajectory utility was negative at\nthis defect-bearing boundary because it induced closure without identifying or\nrepairing either known partial requirement.\n\nThis is the first direct not-ready discrimination result for H05. It is\nconsistent with a recent self-authored closure cue and does not establish safe\nprogress reconciliation.\n\n## Error classification\n\nThe H05 post-run review checked headline facts at a coarser granularity and did\nnot reconcile the candidate hash against the existing frozen adjudication. The\nerror is investigator-side artifact classification. It does not invalidate:\n\n- the three model calls;\n- literal actions and results;\n- candidate custody;\n- tokenizer receipts;\n- replay;\n- tests; or\n- run seals.\n\nThe standalone correction is published at commit\n`a3422cca49cb882ec252ba84903b856ba3cafc24`.\n\n## Governance rule\n\nFuture control/progress utility experiments must freeze an independent\ncandidate-readiness adjudication before maintenance output or treated actor\nbehavior is observed. Candidate hashes must be reconciled against every prior\nadjudication in the donor lineage. Submission is positive only when that frozen\nadjudication says closure is appropriate.<|im_end|>\n<|im_start|>assistant\n{\"action\":\"read_source\",\"end_line\":120,\"source_id\":\"S09\",\"start_line\":1}<|im_end|>\n<|im_start|>user\n{\"object_id\":\"source:S09:1-120\",\"object_version\":\"f4c5d076d0e12b736a09923f3b19bb48d3f18b590586d5a27ba57458d458033d\",\"result_id\":\"RESULT-006\",\"result_kind\":\"source_observation\",\"schema\":\"ceiba-action-result-v1\"}\n--- exact result body ---\n{\"end_line\":120,\"source_id\":\"S09\",\"source_path\":\"sources/S09_MINIMAL_RUNTIME_POLICY.md\",\"source_sha256\":\"f4c5d076d0e12b736a09923f3b19bb48d3f18b590586d5a27ba57458d458033d\",\"source_size_bytes\":5900,\"start_line\":1}\n--- exact source range ---\n# Minimal runtime policy v0\n\nDate: 2026-08-22\nStatus: measured v0 policy; scheduled-reentry component retired after scout E35\n\n> Historical policy lock: this document records the policy tested by the v0\n> scout. It is not the current incumbent. See\n> [REACTIVE_RUNTIME_POLICY_V1.md](REACTIVE_RUNTIME_POLICY_V1.md).\n\n## Scope\n\nThis is the smallest model-facing lifecycle policy supported strongly enough to\ntest as an integrated system. Its reliable part is a **mechanical safety and\noperability substrate**, not an end-to-end task-performance architecture.\n\nEvaluation and research custody are deliberately excluded from this runtime\ntreatment. They are common experimental governance and are specified in\n`MANDATORY_EXPERIMENTAL_GOVERNANCE.md`.\n\n## Runtime policy\n\n### 1. Exact external custody and access\n\nBoth experimental arms have the same exact external task, source, world,\ncandidate, event, effect, and history objects and the same access permissions.\nChanging model-facing residency never changes authoritative bytes.\n\n### 2. Ordinary chronology while healthy\n\nWithin a phase, append ordinary model actions and literal results while the\nnext valid packet remains feasible. Do not continuously rewrite a prompt that\nstill satisfies the arm's frozen reserves.\n\n### 3. Host-owned capacity safety\n\nThe host renders and tokenizes every prospective request and result delivery\nunder the frozen template. The model does not own hard-overflow prevention.\n\nBoth arms pay the same ordinary response reserve. Treatment additionally pays\nthe exact, preflighted transition reserve required by its named transition\nobject. Control is not artificially charged that reserve.\n\n### 4. Deterministic first-fit pressure relief with immediate stop\n\nWhen a pending exact result would violate treatment's frozen envelope, the\nhost scans a frozen ordered list of mechanically eligible, previously delivered,\nexact-backed result bodies. It replaces one body with its exact reopenable\nreceipt, rerenders, and stops immediately at the first feasible packet.\n\nThis is **minimal under the frozen scan order**. It is not a global\nminimum-token or best-subset optimization.\n\nEligibility requires exact external backing, unchanged object/version binding,\nactual prior model-visible delivery, and ordinary exact reopenability. The\npending result cannot be demoted during its own delivery. No semantic relevance\nlabels or model-selected release amounts are used.\n\n### 5. Actor requests reveal demand\n\nReads and reopens remain ordinary actions. The host records reopen cost,\nrepeat reopen, demote-to-reopen interval, re-demotion, novelty, and candidate\nprogress. A reopen is not automatically a failure.\n\n### 6. Frozen bounded-phase reentry\n\nV0 uses only task-authored phase boundaries declared before inference. It does\nnot discover phases automatically.\n\nA boundary fires through a prospectively frozen common event: a valid phase\nhandoff action, completion of a required bounded intermediate artifact, a\nfrozen phase call ceiling, or an externally scheduled transition.\n\nAt that event:\n\n- control appends the common next-phase contract and exogenous phase payload to\n  its existing chronology;\n- treatment starts a fresh packet with the same common phase contract and\n  payload plus only admissible exact current state.\n\nTreatment reentry may include:\n\n1. exact common task and phase inputs declared before any trajectory;\n2. exact current candidate/world mechanically derived from admitted effects;\n3. a pending observation/effect whose delivery caused the transition;\n4. exact objects already delivered to that treatment actor;\n5. a predeclared mechanical causal tail; and\n6. exact handles to everything else.\n\nIt may not introduce an investigator-selected useful source the actor never\nacquired, a post-outcome evidence set, or host semantic relevance judgment.\n\nIf the frozen result-body relief class cannot preserve treatment's reserves and\nno authorized phase transition is available, the endpoint is\n`capacity_exhausted_without_authorized_reentry`.\n\n### 7. Hard trajectory budgets\n\nEach task freezes actor-call, transition-call, serialized-token, and wall-clock\nceilings. Budget exhaustion terminates as\n`budget_exhausted_with_unresolved_task`; it does not force submission or add a\nsemantic maintenance pass.\n\nRecurrence is measured but does not trigger a new intervention in v0.\n\n### 8. Excluded mechanisms\n\nV0 contains no default source digest, working note, progress state,\nmodel-managed residency, host relevance scorer, learned policy, semantic\nsummary, or automatic phase detector.\n\n## Experimental arms\n\n### Control\n\n```text\nsame exact external custody and access\n+ ordinary model-facing chronology\n+ same context window and ordinary response reserve\n+ common task-authored phase events appended to chronology\n+ no result-body pressure relief<|im_end|>\n<|im_start|>assistant\n{\"action\":\"read_batch\",\"requests\":[{\"end_line\":120,\"source_id\":\"S10\",\"start_line\":1},{\"end_line\":80,\"source_id\":\"S11\",\"start_line\":1}]}<|im_end|>\n<|im_start|>user\n{\"call_index\":7,\"candidate_sha256\":\"eb63671008e22987e37ff1ebc26a8ddb29f92ec55ee1d3d1ad0d7d1d64ae181e\",\"code\":\"range_out_of_bounds\",\"message\":\"S10 has 114 lines\",\"repaired\":false,\"schema\":\"architecture-action-rejection-v0\"}<|im_end|>\n<|im_start|>assistant\n{\"action\":\"read_batch\",\"requests\":[{\"end_line\":114,\"source_id\":\"S10\",\"start_line\":1},{\"end_line\":80,\"source_id\":\"S11\",\"start_line\":1}]}<|im_end|>\n<|im_start|>user\n{\"object_id\":\"batch:S10:1-114+S11:1-80\",\"object_version\":\"194184e44b73e83a801c38c5a46a9f237119943c6f52ffa0b5ddc833773f186c\",\"result_id\":\"RESULT-008\",\"result_kind\":\"source_observation\",\"schema\":\"ceiba-action-result-v1\"}\n--- exact result body ---\n{\"schema\":\"architecture-batch-observation-v0\",\"segments\":[{\"end_line\":114,\"source_id\":\"S10\",\"start_line\":1},{\"end_line\":80,\"source_id\":\"S11\",\"start_line\":1}],\"total_source_bytes\":21355}\n--- exact batch segment 1 ---\n{\"end_line\":114,\"source_id\":\"S10\",\"source_path\":\"sources/S10_REACTIVE_RUNTIME_POLICY.md\",\"source_sha256\":\"61824a345b43f00966f8fb9789973f7af06f4db377729cafd38181c2e5097cd4\",\"source_size_bytes\":5437,\"start_line\":1}\n--- exact source range ---\n# Mechanical pressure baseline v1\n\nDate: 2026-08-24\nStatus: evaluated reference instrument; not the active architecture or research route\n\n## Correction from v0\n\nThe fresh-task scout did not exercise pressure relief. Every prompt remained\nbelow 10,000 tokens against an approximately 21,000-token prompt allowance.\nTreatment activated only scheduled call-count reentry, which solved no current\ncapacity problem, reduced cache reuse in every pair, and disrupted one\nqualified code trajectory.\n\nV1 therefore removed scheduled phase reentry and retained the pressure\nmechanism supported by earlier local experiments. That mechanism has since been\nexercised on a fresh pressure-qualified Ceiba task.\n\n## Reference policy\n\n```text\nexact external custody and access\n+ ordinary chronology while healthy\n+ host-owned response and named control reserves\n+ on authentic prospective result overflow:\n     prospectively render each exact-body→receipt candidate\n     skip substitutions with zero or negative token recovery\n     deterministic first-fit relief among positive-savings candidates\n       under a frozen scan order\n     and immediate stop at feasibility\n+ exact reopen on actor demand\n+ reactive exact reentry only if the declared relief class is insufficient\n  or a prospectively declared external authority/world transition requires it\n+ candidate-bound observation currency\n+ hard call/token/time ceilings\n```\n\nThe host owns exact custody, version/hash binding, token accounting, reserves,\nprospective receipt-cost calculation, receipt substitution, and admission. The\nactor supplies ordinary task decisions and actual read/reopen demand. No model\nmanager predicts the whole working set in this reference condition.\n\n## Reentry admissibility\n\nReentry is not triggered by phase name, call count, apparent confusion, or host\njudgment that construction should begin. A packet may contain only exact common\ntask/authority inputs, exact current candidate/world, the pending update that\ncaused the transition, exact information already delivered to that actor, a\npredeclared mechanical causal tail, and exact handles.\n\nIt may not introduce investigator-selected useful evidence or semantic\nrelevance unavailable to control.\n\n## Diagnostics and currentness\n\nRaw tool output is preserved exactly. A task-specific deterministic\nmodel-visible projection may omit prospectively declared volatile transport\nfields while retaining stable criterion IDs/statuses, readiness, blocking\nrequirements, candidate binding, and a raw-result handle.\n\nEach check is bound to the candidate/world version it evaluated. After a later\neffect, the host may state mechanically that the earlier check is stale and\nthat the current candidate has not been verified by it.\n\n## Excluded from this baseline\n\nScheduled reentry, semantic notes, digests, progress-state cues, model-owned\neviction, host relevance scoring, automatic phase detection, and learned\nrouting remain excluded from this mechanical baseline. This is not a program-\nwide judgment that those arrangements can never be useful. Discovery probes may\ntest them when an independently motivated capability question requires the\ncontrast.\n\n## Measured disposition\n\nAt the fresh Ceiba pressure boundary, deterministic first-fit relief admitted\nthe pending result and repeatedly preserved prompt feasibility. In each 18-call\ncontinuation, ten later pressure events required sixteen substitutions and\n80,497 cumulative recovered prompt tokens. The actor continued through novel\nsource ranges without exact reopen churn.\n\nNo mutation, check, submission, or artifact improvement occurred. Required\nevidence remained incomplete and the actor-call budget, not context capacity,\nended the run. Seed 314159 v2 is the separately qualified primary cell and\naggregate. Seed 43's action/lifecycle history is post-freeze replay-qualified,\nwhile its primary v1 cell and aggregate remain sealed-aborted. The two histories\nproduced the same model-facing trajectory at one donor boundary; they are not\nindependent task replications.\n\nThe result qualifies the policy's narrow use as a mechanical pressure and\nobservation instrument. It does not qualify it as a complete working-state or\ntask-performance architecture and does not select a longer receipt-only\ncontinuation.\n\nE40 subsequently exposed an apparatus correction to the eligibility law. One\nI1 one-line exact observation was technically custodied and marked eligible,\nbut its rendered receipt increased the prompt by 79 tokens. The following\nsubstitution restored feasibility, so the literal trajectory continued; the\nfirst operation was nevertheless not relief and censors the full E40 matrix.\n\nThe corrected baseline therefore defines eligibility by the complete\nprospectively rendered prompt delta, not object class alone. Equal- or\nnegative-savings substitutions remain exact-resident. If no positive candidate\ncan preserve the frozen reserves, the runtime follows its predeclared reactive\nreentry or terminal path. This is a mandatory safety correction, not a new\neviction optimization branch.\n\n## Claim bound\n\nThis is a pressure-response comparator, not a complete agent architecture.\nUse it when a discovery or confirmation question genuinely activates result-\ndelivery pressure. Do not require every capability probe to occur at a pressure\nboundary and do not optimize this policy by default.\n\nThe active program route is `STRUCTURED_EXPLORATION_ROADMAP.md`.\n--- exact batch segment 2 ---\n{\"end_line\":80,\"source_id\":\"S11\",\"source_path\":\"sources/S11_CAPABILITY_TERRAIN.md\",\"source_sha256\":\"c550197261ae54996b5978789a8ee160e153946b89c713a20c302681179430d7\",\"source_size_bytes\":19526,\"start_line\":1}\n--- exact source range ---\n# Capability terrain map\n\nDate: 2026-08-24\n\nStatus: updated through the first pressure-active interaction; not a prevalence estimate or architecture\n\n## Purpose and limits\n\nThis map reorganizes the existing evidence by information-processing function\nrather than by mechanism name. It is deliberately small. Its purpose is to\nshow what has actually been observed, what recurs across independent worlds,\nand where the program remains too narrow to justify optimization.\n\nThe source of truth for claim scope remains `EVIDENCE_LEDGER.md`. Heterogeneous\ntasks, models, interfaces, horizons, and evaluators are not pooled. A mark of\nrecurrence means a broadly similar functional boundary appeared in independent\nworlds; it is not a causal estimate or architecture promotion.\n\nEvidence imported from `bounded-context-harness-effects` uses Qwen 3.6 27B,\nmostly rule-dense JavaScript coding tasks, a larger context regime, and\ndifferent action interfaces. It supplies cross-profile functional analogues\nand within-program task recurrence. It is not pooled replication of the\nQwen3.8 large-world studies and does not transfer treatment effects,\nprevalence estimates, or model-specific capability claims.\n\n## Independence groups represented so far\n\n| Group | Representative evidence | Relationship to other groups |\n|---|---|---|\n| Navigation synthesis world | E03–E26, E33–E34 | Many seeds and packet variants share one task/world and donor lineage. They count as deep local evidence, not independent-world breadth. |\n| Older code false-closure and repair worlds | E27–E30 | Multiple pinned tasks and studies imported through the prior-evidence audit. Apparatus differs from the standalone sequence. |\n| Older research and phase-reentry worlds | E30 | Multiple code/research workflows with task-authored boundaries. Independent of the navigation world but heterogeneous internally. |\n| Large-document exact-handoff worlds | E31 | Two related maintenance trajectories; close transfer rather than broad independence. |\n| Fresh whole-method research task | E35 | Independent task/world; low occupancy, strict action interface, nine-call horizon. |\n| Fresh whole-method code task | E35 | Independent task/world; effect/check/repair workflow, scheduled low-occupancy reentry treatment. |\n| Fresh Ceiba charter task | E36, E39–E40 | Independent large-world synthesis task; authentic pressure, receipt-only streaming, then a same-world ingress × semantic-work interaction. Seed and configuration variants remain one independence group, not transfer. |\n| Capability-terrain reconnaissance | E37 | Five source/candidate lineages across atlas navigation, research revision, and three code/review situations. D6 inherits D2 and is not independent. The portfolio is enriched from known fixtures and shares one profile/interface, so it broadens functional coverage without estimating prevalence. |\n| Sister Qwen 3.6 action/effect worlds | Experiments 101–113 in `bounded-context-harness-effects`: 17 named coding task worlds; reused tasks and frozen-state studies are identified separately | Cross-profile, cross-apparatus triangulation only. The bank broadens coding action/effect coverage but is neither Qwen3.8 context-window replication nor broad domain sampling. |\n\n## Terrain by functional boundary\n\n| Function | Literal evidence | Independent recurrence | Current disposition |\n|---|---|---|---|\n| Exact custody and recovery | Exact objects, versions, candidates, events, effects, and handles were preserved and reopened across the navigation studies; fresh tasks retained exact world and candidate custody. | Yes, across navigation, older phase/handoff, fresh scout, and Ceiba worlds. | Strong mechanical substrate. Continue as validity infrastructure, not the main discovery question. |\n| Prospective capacity safety | Small first-fit demotions admitted blocked results in E03; repeated relief maintained the navigation horizon in E04; E36 repeated the operation on a fresh Ceiba world. E40 exposed one tiny exact body whose receipt cost 79 more prompt tokens. | Yes: navigation and Ceiba are independent task worlds. | Qualified mechanical baseline with a corrected eligibility law: prospective rendered savings must be strictly positive. Further ordering or same-boundary horizon tuning is low priority. |\n| Relevant-information discovery | Navigation actors found target/source regions; whole-method research actors acquired several sources; Ceiba actors traversed novel source ranges through S11. E37 D2/D5 selected task-relevant records, while D1/D3/D4 exposed legible discovery intent that often failed admission. | Broad behavior appears across worlds, but task and interface differences prevent a stable capability estimate. | Distinguish selection intent from admitted observation. Sample fresh sparse-discovery worlds only through an observation surface qualified to expose the intended function. |\n| Exact selection and access | Handles were usable. Fixed directories/focus and one-shot model-managed release selection were locally unstable in the navigation world. Ceiba reads were novel and non-overlapping. Sister tasks also contain redundant access to already supplied evidence, but that is not the same phenomenon as bad eviction selection. | Release-selection instability remains local to the navigation lineage. Literal-but-unused or deliberately reread evidence appears more broadly. | Distinguish information not found, found but not literal, literal but not behaviorally used, and deliberate rereading. Do not infer an eviction-policy failure from every reread. |\n| Relationship formation and qualification capture | The navigation candidate became a strong partial; one fresh research control produced a substantial 9/12 memo; E37 D2 integrated three exact records but lost one qualification. In E40, bounded work records expressed cross-source relationships and cited 13 sources over time, yet each final record retained only four citations. Sister semantic ledgers and relation surfaces could express compact relationships but sometimes changed exact values or overloaded later expression. | Suggestive across profiles and tasks; E40 adds active formation plus within-trajectory attrition in the Ceiba world. | Separate formation from retention, provenance metadata, artifact binding, and later use. A semantic record can be broad at one version and noncumulative over replacement. |\n| Relation-to-action binding | Sister Experiment 111 explicitly represented a device rule that every implementation omitted; other relation/operand surfaces helped one state and harmed or failed others. E37 D2 omitted a required missingness basis and D5 omitted required-disabled-service rejection despite substantial otherwise coherent artifacts. | Yes as a broad failure shape across independent research/code lineages and the sister program; exact mechanisms and interfaces differ. | Eligible for cross-world confirmation. Separate relation availability, explicit formation, artifact materialization, check coverage, and repair rather than treating artifact score as one latent failure. |\n| Acquisition stopping | Navigation horizons included repeated reads and a period-three reopen loop. Ceiba continued novel acquisition, but required evidence remained outstanding. | No. The literal behaviors differ and the Ceiba case does not establish sufficient evidence. | Keep explanations plural: legitimate acquisition, missing semantic residue, task geometry, action granularity, or control failure. Seek an evidence-complete independent world. |\n| Intended-action formation | Exact reentry produced a grounded mutation in one navigation seed; several older/fresh code cells formed edits; Ceiba produced only reads. E37 contained legible but rejected navigation/read intents and two admitted large replacements. | Action formation exists across worlds; expression and admission can hide it. | Code intent, expression, admission, and effect separately. Observe when evidence becomes a bounded plan, section, patch, or decision rather than only another read. |\n| Action organization | In the sister 105–112 selected audit, immediate target expression often predicted candidate materialization, but no observed operator/scope/position/sequence feature predicted correctness across enough matched blocks. Optional fresh response changed organization even when unused. | Strong within sister coding tasks; undercoded in the Qwen3.8 line. | First-class breadth axis: another read, inspection, bounded edit, whole-file mutation, staged operation, or no admitted action are different organizations of work. |\n| Action expression and admission | Note/frontier calls hit output/grammar limits; the fresh whole-method scout rejected 19/71 actor responses; Ceiba had two over-range action rejections. E37 rejected 19/39 responses at low occupancy: 11 fenced plausible objects, seven extra-syntax objects, and one array. In the sister 105–111 audit, 33/102 selected episodes stopped at response/channel expression before a candidate, and response headroom causally changed candidate materialization on new tasks. | Yes across multiple Qwen3.8 worlds and the sister profile, while exact causes and interfaces differ. | High-priority observation-surface boundary. Qualify transport across multiple task situations without silently repairing semantic choices; never infer downstream incapability from malformed output or correctness from successful admission. |\n| Durable work-product accumulation | Most navigation and Ceiba treatments exposed whole-artifact mutation. The fresh research task wrote its whole memo on the last call. E40 charged 40 maintenance calls and admitted 38 bounded evidence-integration replacements, but those objects were lossy sidecars, not exact partial task artifacts; no candidate changed. Sister studies tested staged transactions and whole-file expression, not partial work as durable cognition across turnover. | No clean cross-world utility test of independently evaluable incremental work as external cognition. | Major gap sharpened by E40. Explore semantic integration × exact partial artifact × version-bound feedback inside a full ingress/effect/repair/closure loop, not as isolated note or patch expression. |\n| Effect/currentness uptake | Recurrent exact-state work delivered an inherited patch effect; fresh code reentry exposed stale-check/new-candidate ambiguity. E37 D2/D5 both took an admitted mutation effect into a later decision and then ran a current check. In the sister transition corpus, 62/63 candidate-bearing episodes ran a model-visible check, yet all 24 externally incorrect artifacts had green visible checks. | Effect-to-check continuation recurs across independent worlds; correct evidential use does not follow. | Split effect visibility, observation currency, feedback discrimination, useful repair, and closure. Use exact candidate-bound current/stale diagnostics. |\n| Feedback and repair | Imported false-closure audits activated repair. Sister evidence shows discriminating failures can activate useful repair, green incomplete checks can stabilize wrong artifacts, and malformed model-authored tests can cause perseveration after an artifact is correct. Mechanical authorship/provenance improved selection in 0/3 misleading states. | Yes across independent sister worlds, with functional analogues in the Qwen3.8 line. Rates and interventions are not pooled. | Explore repair under discriminating, nondiscriminating, stale, and misleading feedback. Do not equate “check ran” with useful feedback. |\n| Readiness and closure | H05 converted a reread into premature submission of a known strong partial. E37 D2 and D5 submitted independent strong-partial artifacts after visible checks passed; D6 then resubmitted D2 unchanged from exact current state. The sister funnel contained 39 correct artifacts among 70 candidates, 28 full successes, and 11 correct-artifact/noncompletion cases. | Yes: artifact quality, verification coverage, and closure dissociate across independent tasks, interfaces, and profiles. | Consequential recurring boundary eligible for cross-world confirmation. No generic progress cue is selected; exact external readiness adjudication remains mandatory. |\n| Response-level continuation | Sister Experiment 112 selected optional `yield_response` in 0/4 eligible states; its availability still changed action organization. Experiment 113 repaired the only eligible exact-prefix incomplete payload to an 8/8 artifact, but only 1/3 large blocks exposed the boundary and no economy advantage appeared. | Narrow local feasibility only. | Treat as response allocation/expression repair, not semantic resumption or decomposition. No promotion. |\n| Phase reentry and bounded resumption | Older Qwen3.8 code/research studies preserved core continuity in fresh phases; scheduled low-occupancy reentry in E35 paid cache cost and sometimes harmed continuity; reserved handoff did not guarantee action-ready selection. E37 D6 immediately recovered the donor's closure disposition from exact current state, but repeated its false readiness judgment. | Mixed direction across independent Qwen3.8 domains and triggers; D6 is same-lineage descriptive evidence. | Separate orientation/action-category continuity from correct semantic/readiness continuity. Do not promote automatic phase reset. |\n| Decomposition and reintegration | No completed study cleanly assigns bounded subwork and then measures reintegration of its exact and semantic output into the parent artifact. | No. | Genuine terrain gap. Keep child/role labels provisional and test only through a bounded authentic task. |\n| Model-authored semantic persistence | Qwen3.8 source digest was behaviorally active but increased short-horizon recovery. A progress package caused premature closure. E40 maintenance produced substantial grounded prose but replacement lost prior citation breadth and did not induce task-artifact work. The sister coverage ledger was used in 6/6 cells while artifacts fell from 6/6 to 3/6. | Behavioral activity and risk recur; positive durable utility does not. The representations and their placement are not interchangeable. | Semantic externalization changes demand and control. Next test its coupling to exact task work and feedback; do not optimize another detached note format. |\n| Model-managed workspace allocation | Passive controls were unused; dedicated selection was reachable but over-released and immediately contradicted by next actor demand. | One navigation world only. | Current prompt-tuning route closed. Revisit only if independent worlds make release identity the dominant boundary. |\n\n## What the map says now\n\nFive conclusions are now comparatively broad:\n\n1. Exact custody and prospective capacity safety are reusable mechanical\n   substrate functions.\n2. Operability does not establish relationship assembly, action formation,\n   effect uptake, repair, or correct closure.\n3. Semantic and control packages are behaviorally active enough to create risk;\n   their value depends on configuration and downstream artifact quality.\n4. Action expression and admission can dominate long before context pressure,\n   and can prevent downstream capability from becoming observable.\n5. Successful mutation and current-check uptake do not establish complete\n   requirement binding or correct readiness.\n\nThe largest coverage gaps are not another eviction choice. They are:<|im_end|>\n<|im_start|>user\n{\"object_id\":\"sidecar:integration-ledger\",\"object_version\":\"7fb5ee436cf5f336d7f52092b621556c42db6e4f6ee6c2a8f36fb671847a3d1b\",\"result_id\":\"MAINT-EFFECT-001\",\"result_kind\":\"semantic_state_effect\",\"schema\":\"ceiba-action-result-v1\"}\n--- exact result body ---\n{\"artifact_coupled\":false,\"body_sha256\":\"7fb5ee436cf5f336d7f52092b621556c42db6e4f6ee6c2a8f36fb671847a3d1b\",\"body_tokens\":1090,\"candidate_sha256_unchanged\":\"eb63671008e22987e37ff1ebc26a8ddb29f92ec55ee1d3d1ad0d7d1d64ae181e\",\"integration_version\":1,\"schema\":\"architecture-detached-integration-effect-v0\"}<|im_end|>\n<|im_start|>user\n# Current exact interaction-state binding\n{\"artifact_coupled\":false,\"candidate_sha256\":\"eb63671008e22987e37ff1ebc26a8ddb29f92ec55ee1d3d1ad0d7d1d64ae181e\",\"candidate_version\":\"candidate-v000:eb63671008e22987e37ff1ebc26a8ddb29f92ec55ee1d3d1ad0d7d1d64ae181e\",\"check_binding\":null,\"configuration_id\":\"D0_DETACHED\",\"integration_body_embedded_below\":true,\"integration_body_sha256\":\"7fb5ee436cf5f336d7f52092b621556c42db6e4f6ee6c2a8f36fb671847a3d1b\",\"integration_input_result_ids\":[\"RESULT-002\",\"RESULT-003\"],\"integration_source_ids\":[\"S02\",\"S03\",\"S04\",\"S08\"],\"integration_version\":2,\"model_authored_lossy\":true,\"readiness_authority\":false,\"residency_role\":\"non_authoritative_model_facing_sidecar\",\"resident_body_sha256\":\"7fb5ee436cf5f336d7f52092b621556c42db6e4f6ee6c2a8f36fb671847a3d1b\",\"schema\":\"artifact-coupled-current-interaction-state-v0\"}\n--- current bounded model-authored integration body ---\n# Evidence Integration Ledger\n\n**R01: Exact External Custody and Reopenability**\nDisposition: Qualified mechanical substrate earned. Exact external custody maintains byte integrity, but reopenability is reactive rather than scheduled. Scheduled low-occupancy reentry failed to earn a default role [S02]. Reactive exact reentry remains an unpromoted fallback for insufficient declared relief [S02]. Unresolved evidence: No fresh-task scout has validated proactive reopen strategies under high pressure [S02].\n\n**R02: Response/Control Reserves and Positive-Savings Relief**\nDisposition: Deterministic first-fit pressure relief is qualified. It is strictly restricted to prospectively rendered, strictly positive-savings substitutions under a frozen scan order [S02]. Reactive reentry activates only when declared relief is insufficient [S02]. Unresolved evidence: The I1 relief event replaced a one-line body with a receipt costing 79 more tokens, remaining descriptive rather than validating broader utility [S02].\n\n**R03: Capacity, Delivery, Action, Effect Uptake, Quality, and Closure**\nDisposition: Distinct boundaries identified but not jointly validated. The I1–I4 run activated batch ingress and work sidecars, yet no mutation, effect uptake, check, or submission occurred [S02]. Capacity remained active but non-terminal; call budget became terminal while evidence remained incomplete [S02]. Unresolved evidence: Joint effects of these boundaries within a complete bounded trajectory remain untested [S02].\n\n**R04: Recoverability, Residency, Behavioral Accessibility, and Working-Set Adequacy**\nDisposition: Distinct properties acknowledged. Value is conditional on task phase, co-resident set, and regime, not intrinsic [S03]. Semantic compression lowers resident cost but introduces task-dependent loss [S03]. Unresolved evidence: No scalar weights are earned for these properties; costs must be reported as vectors, not aggregates [S03].\n\n**R05: Chronology’s External and Resident Lifecycle**\nDisposition: Ordinary chronology is qualified while healthy. History growth causes useful exact evidence to lose co-residency, increasing reopening churn [S03]. Unresolved evidence: Interaction between chronology lifecycle and semantic persistence remains untested in fresh trajectories [S02].\n\n**R06: Cache/Prefill and Decision-Bandwidth Costs**\nDisposition: Costs are path-dependent and partly endogenous. Cache invalidation and prefill latency are distinct accounting factors [S03]. The I1–I4 run consumed 2,112,973 serialized tokens, qualifying action transport but not downstream utility [S02]. Unresolved evidence: No mathematical chaos demonstrated; only seed sensitivity and changing bottlenecks observed [S03].\n\n**R07: Semantic Derivatives as Endogenous Demand/Control Inputs**\nDisposition: Semantic derivatives are endogenous demand inputs. A newly produced digest may be valuable only after raw source leaves residency [S03]. Unresolved evidence: The failed source-bound semantic residue route (exceeding 256-token budget at 310 tokens) is closed; no v3 allowed [S02].\n\n**R08: Source-Digest Negative and Progress-State False-Closure Risk**\nDisposition: High risk confirmed. The first proposed interaction failed its prospective apparatus gate before actor trajectory ran [S02]. Provenance repairs improved acceptance, but budget constraints closed the dedicated residue route [S02]. Unresolved evidence: False-closure risk in progress-state remains unquantified across independent worlds [S02].\n\n**R09: Host/Model Ownership Supported by Manager and Paging Results**\nDisposition: Host-owned response and control reserves are earned. Manager and paging results support host ownership, but model-owned eviction is not validated [S02]. Unresolved evidence: No general architecture validation; only local mechanism evidence exists [S02].\n\n**R10: E40’s Detached-Sidecar versus Task-Artifact Gap**\nDisposition: Gap confirmed. The work sidecar produced genuine cross-source prose but shed earlier citations, citing only four sources despite 13/14 allowlists [S02]. It functioned as semantic state, not an exact partial charter or independently checkable task artifact [S02]. Unresolved evidence: No successful transfer of sidecar content to durable work-product externalization [S02].\n\n**R11: Interaction-First Roadmap with Fresh Transfer and Stopping Rules**\nDisposition: Active route defined. The next candidate interaction is evidence-ingress bandwidth × cumulative task-native work externalization [S02]. Stopping rules are frozen; no v3 for failed designs [S02]. Unresolved evidence: No whole configuration has yet shown meaningful joint effect transferring to an independent world [S02].\n\n**R12: Evaluation/Readiness Lineage and Candidate-Bound Currentness**\nDisposition: Independent candidate/task/evidence-bound evaluation is mandatory common governance [S02]. The I1–I4 run is frozen for measurement at a specific commit hash [S02]. Unresolved evidence: No readiness lineage established for general architecture; only local negatives qualify [S02].<|im_end|>\n<|im_start|>user\n{\"object_id\":\"sidecar:integration-ledger\",\"object_version\":\"7fb5ee436cf5f336d7f52092b621556c42db6e4f6ee6c2a8f36fb671847a3d1b\",\"result_id\":\"MAINT-EFFECT-002\",\"result_kind\":\"semantic_state_effect\",\"schema\":\"ceiba-action-result-v1\"}\n--- exact result body ---\n{\"artifact_coupled\":false,\"body_sha256\":\"7fb5ee436cf5f336d7f52092b621556c42db6e4f6ee6c2a8f36fb671847a3d1b\",\"body_tokens\":1090,\"candidate_sha256_unchanged\":\"eb63671008e22987e37ff1ebc26a8ddb29f92ec55ee1d3d1ad0d7d1d64ae181e\",\"integration_version\":2,\"schema\":\"architecture-detached-integration-effect-v0\"}<|im_end|>\n<|im_start|>assistant\n{\"action\":\"read_source\",\"end_line\":120,\"source_id\":\"S12\",\"start_line\":1}<|im_end|>\n<|im_start|>user\n{\"object_id\":\"source:S12:1-120\",\"object_version\":\"0f13778c862fa91d79406ab854fa3c67ecc213c1506a9f24b8625e6a011622a9\",\"result_id\":\"RESULT-009\",\"result_kind\":\"source_observation\",\"schema\":\"ceiba-action-result-v1\"}\n--- exact result body ---\n{\"end_line\":120,\"source_id\":\"S12\",\"source_path\":\"sources/S12_DISCOVERY_TRANCHE_RESULT.md\",\"source_sha256\":\"0f13778c862fa91d79406ab854fa3c67ecc213c1506a9f24b8625e6a011622a9\",\"source_size_bytes\":10717,\"start_line\":1}\n--- exact source range ---\n# Capability-terrain reconnaissance v0: program disposition\n\nDate: 2026-08-23\n\nStatus: measured breadth tranche complete; result incorporated into discovery routing\n\n## Answer first\n\nThe first breadth tranche did not find a context-capacity failure or a correct\nend-to-end completion. It found a different and more immediate systems\nboundary:\n\n> At low context occupancy, the actor could sometimes integrate evidence,\n> construct a large artifact, absorb its effect, and use a current check, but\n> legal action expression and correct readiness discrimination were unreliable.\n\nAcross 39 actor calls, 19 responses were rejected before an action reached the\nenvironment. D2 and D5 nevertheless completed substantial construction paths,\nthen submitted strong-partial artifacts after narrower visible checks passed.\nD6 received D2's exact current state without its construction chronology and\nrepeated the same premature-closure disposition. No cell achieved independently\ncorrect useful completion.\n\nThis result supplies a low-pressure reference regime. It does not answer the\nprogram's intended interaction question. Context pressure, semantic\npersistence, incremental work, and matched lifecycle alternatives never became\nactive together, so the tranche cannot establish how those functions alter one\nanother. Its valid contribution is to identify boundaries that a later\ninteraction study must keep inside the same closed loop.\n\n## Exact source binding\n\n- experiment repository: `ScrappyTom/qwen38-capability-terrain-reconnaissance-v0`\n- frozen design commit: `f3092c73065353d5fbdb4c3646632b6586c7e50b`\n- measured result commit: `ea8f4cfa5888998d6193f57316e9cd41cf1639b6`\n- run ID: `2026-08-23-capability-terrain-v0`\n- result narrative SHA-256:\n  `c6b6d09c5093f552dd6c225ba04ce9d66cf435a1f22b9b9f6050ea71a8721c60`\n- direct transcript audit SHA-256:\n  `7769875b9d9067f5ec1a827c9f59fdd5ec9e1f977fd6a798262a99321d96b7a8`\n- raw-run manifest content digest:\n  `b6b40c3c444348efe1bcd6a26886806d67d215d04d78283b3d456dcd63cdfd3b`\n\nThe measured repository contains the complete requests, responses, results,\ncandidates, checks, evaluator outputs, mechanical audit, and candidate-bound D2\nsemantic adjudication. Its clean-checkout suite passed 25 tests, the mechanical\naudit, and the D2 adjudication validator.\n\n## Mechanical result\n\n| Measure | Result |\n|---|---:|\n| Actor calls | 39 |\n| Provider attempts | 39 |\n| Retries | 0 |\n| Prompt tokens | 96,407 |\n| Completion tokens | 5,250 |\n| Serialized tokens | 101,657 |\n| Cached prompt tokens | 73,830 |\n| Aggregate prompt-cache reuse | 76.58% |\n| Accepted actions | 20 |\n| Rejected responses | 19 |\n| Pressure events | 0 |\n| Result-body substitutions | 0 |\n| Exact reopens | 0 |\n| Correct useful completions | 0 |\n\nThe largest prompt was 7,110 tokens against a 20,992-token prompt allowance.\nContext relief, receipt substitution, and reopen behavior were therefore\ninactive. They cannot explain the measured failures.\n\n## Literal cell outcomes\n\n| Cell | Literal trajectory | Artifact and closure disposition |\n|---|---|---|\n| D1 large-world navigation | One admitted `atlas_root`; three malformed but legible navigation actions | No memo; discovery beyond the root remained unobserved |\n| D2 paper revision | Tree, three exact reads, full replacement, current check, submit | Strong partial: 12/13 semantic criteria; premature closure |\n| D3 ordinary-success calibration | Seven fenced `tree` requests, then one admitted `tree` | Starting failure unchanged; downstream coding capability unobserved |\n| D4 rule-dense construction | Tree and two reads admitted; six malformed actions | Starting failure unchanged; construction unobserved |\n| D5 deployment-wave repair | Three reads, large full replacement, current check, submit | Strong partial: 7/8 external criteria; premature closure |\n| D6 exact current-state handoff | Two fenced submits, then admitted submit | Byte-identical D2 candidate; same premature closure |\n\nThe rejected responses were not random semantic wandering. Eleven wrapped a\nplausible action object in Markdown fences, seven added extra braces, closing\ntags, or a duplicate object, and one returned a one-element array. Intent was\nusually legible, but the declared transport was not satisfied and the strict\nhost correctly did not repair it.\n\n## What the tranche teaches about the low-pressure regime\n\n### 1. Useful operation is conjunctive\n\nThe observed economics are better described as:\n\n```text\naccessible information\nx formed relation\nx intended operation\nx legal expression\nx admitted effect\nx discriminating feedback\nx correct readiness decision\n= useful completion\n```\n\nAmple context or successful acquisition cannot compensate for a zero at a later\nboundary. D3 and D4 spent prompt-heavy calls repeatedly expressing tiny invalid\nactions. D2 and D5 crossed expression, construction, and effect uptake, but lost\none governing requirement apiece and then trusted incomplete verification.\n\n### 2. Action transport is part of the information economy\n\nThe model-facing protocol determines whether an intended operation can become\nworld state. A rejected 20-token action can consume the same scarce actor-call\nslot as a substantive edit. This makes expression/admission a first-class\nthroughput boundary, not merely cosmetic output formatting.\n\nThe result does not show that JSON fencing caused the D2 or D5 semantic defects,\nnor that silently repairing malformed actions would be safe. It does show that\nan observation instrument must qualify its transport well enough to expose the<|im_end|>\n<|im_start|>assistant\n{\"action\":\"read_batch\",\"requests\":[{\"end_line\":120,\"source_id\":\"S14\",\"start_line\":1},{\"end_line\":80,\"source_id\":\"S05\",\"start_line\":1}]}<|im_end|>\n<|im_start|>user\n{\"object_id\":\"batch:S14:1-120+S05:1-80\",\"object_version\":\"84a7d3fed519838773ab5e238b77f6f657fa339bc990c02ed256cd891d3873a6\",\"result_id\":\"RESULT-010\",\"result_kind\":\"source_observation\",\"schema\":\"ceiba-action-result-v1\"}\n--- exact result body ---\n{\"schema\":\"architecture-batch-observation-v0\",\"segments\":[{\"end_line\":120,\"source_id\":\"S14\",\"start_line\":1},{\"end_line\":80,\"source_id\":\"S05\",\"start_line\":1}],\"total_source_bytes\":9797}\n--- exact batch segment 1 ---\n{\"end_line\":120,\"source_id\":\"S14\",\"source_path\":\"sources/S14_PRIOR_EVIDENCE_RECONCILIATION.md\",\"source_sha256\":\"80fb23325bf09b9e2529ab8a2d65e81e9dca8637a6b785256814963f4be3ec95\",\"source_size_bytes\":6229,\"start_line\":1}\n--- exact source range ---\n# Next-route prior-evidence reconciliation\n\nDate: 2026-08-22\n\nStatus: complete; proposed submission-reflection experiment not selected;\nbounded phase reentry reclassified from untested; zero GPU calls\n\n## Why this audit was necessary\n\nAfter H05's correction, the tentative next route was a new submission-bound\nreadiness-reflection discrimination followed, if ineligible, by bounded phase\ndecomposition. A direct pinned-donor search found that both functional questions\nalready have substantial Qwen3.8 evidence in the older research program.\n\nRunning either under a new standalone name without reconciling that evidence\nwould not be a clean next experiment. It would rediscover an existing method\nclass while understating its known failure modes.\n\nThis audit reads 13 result objects directly from commit\n`b7e12ab21cec1ef8215e97dc9890924721651f1d` of\n`E:\\research-state-integration-2026-08-18`. Their Git blobs, SHA-256 hashes,\nand byte sizes are locked in `NEXT_ROUTE_PRIOR_EVIDENCE_LOCK.json` and verify\nin `NEXT_ROUTE_PRIOR_EVIDENCE_RECEIPT.json`.\n\n## Submission readiness is already an evidence-rich boundary\n\nFour complete-audit studies tested authentic Qwen3.8 false closure with exact\ntask-derived execution evidence:\n\n- the first matched scout improved all 3/3 complete-audit branches and produced\n  two complete candidates while narrow evidence improved none;\n- the held-out replication activated mutation in 6/6 complete-audit branches,\n  but won only 3/6 pairs under a four-win gate and produced two complete\n  candidates;\n- automatically refreshing the complete audit after each mutation won 1/5\n  pairs and used roughly three times the static condition's tokens; and\n- running the complete audit only when the actor attempted submission improved\n  4/5 qualified episodes, but only one reached complete admitted submission and\n  post-submit work cost 4.54 times the tokens used through first submission.\n\nThe repeated bounded result is already clear: exact candidate-bound complete\nverification is a strong false-closure detector and repair activator, but not a\nreliable, economical repair-and-closure policy.\n\nTwo model-authored review studies also constrain a new reflection pass:\n\n- a qualified binary assessor correctly found a real support gap, but the\n  original builder finalized the same artifact in both receipt-only and review\n  conditions; and\n- aggregate versus task-author atomic review detected only 2/7 versus 3/7\n  known violations. Both methods falsely supported multiple defect-bearing\n  requirements despite receiving the exact task and candidate.\n\nTherefore another plain model-authored readiness message would not isolate a\nnew mechanism. It would revisit known questions about defect recall, optional\nreview uptake, and closure cueing. H05 already supplies an additional local\nwarning: a recent progress package can induce premature unchanged submission.\n\n## Bounded phase reentry is not untested\n\nThe fallback H06 route also has prior evidence:\n\n- a phase-state scout showed that fresh current-world actors completed one code\n  and one research revision without the accumulated transcript;\n- a fresh replication again produced the best code artifact and a clean\n  research memo from exact current-world reentry, while the model-authored\n  checkpoint package failed promotion; and\n- a three-phase longitudinal study preserved all task-grounded code behavior\n  and required research distinctions through two authority changes. Fresh\n  world used 20.3% fewer research tokens and 34.1% lower maximum prompt\n  occupancy, but needed more calls and slightly more inference time.\n\nThis supports bounded phase reentry as a removable local operating technique.\nIt does not support automatic phase routing, semantic checkpoints, or the claim\nthat history is useless. Transcript history remained useful for navigation and\nsometimes produced cleaner semantic output.\n\n## Reserved handoff does not reopen the simple selector route\n\nGuaranteed maintenance/control opportunity has also been exercised in a close\nmethod family:\n\n- scheduled handoff successfully produced and delivered a model-authored exact\n  receipt selection, but the actor selected every available receipt and reached\n  capacity before mutation; and\n- projected scheduled handoff combined selective structural navigation with\n  exact transfer. The fresh actor accepted all transferred evidence without\n  reopening it, then reconstructed 98% of the target and again reached capacity\n  before mutation.\n\nThus `reserve a maintenance turn` solves control-plane reachability, not\nworking-set selectivity or downstream acceptance. A new forced maintenance\nturn would need a materially different resource-allocation question, not a new\nlabel for these handoffs.\n\n## Systems interpretation\n\nThe reconciled evidence strengthens a state-conditional view:\n\n```text\nexact verification at closure\n    -> strong defect visibility and repair activation\n    -> incomplete/expensive repair remains\n\nfresh exact phase reentry\n    -> bounded continuity can survive without full chronology\n    -> navigation work and semantic derivatives still have variable value\n\nreserved exact handoff\n    -> control operation becomes reachable and exact transfer works\n    -> selected state can still be globally broad or rejected as sufficient\n```\n\nThese are not one failed architecture. They are different operating regimes\nwith different owners, costs, and failure migrations.\n\n## Decision\n\nDo not build or run the proposed submission-bound reflection experiment. Do not\nmark bounded decomposition as untested. Do not respond by tuning review wording,\n--- exact batch segment 2 ---\n{\"end_line\":80,\"source_id\":\"S05\",\"source_path\":\"sources/S05_DECISION_GEOMETRY_AUDIT.md\",\"source_sha256\":\"a9f1597b10ac211418748aa13c96debc85698c597c6e85f4b54b936a959ed101\",\"source_size_bytes\":14848,\"start_line\":1}\n--- exact source range ---\n# E36 Decision-Geometry Audit\n\nStatus: offline, read-only reconstruction\n\nThis document reconstructs the decision-level information and action geometry\nof the E36 seed-314159 v2 pressure-recovery trajectory. It separates exact\nmechanical facts from weaker evidence-availability proxies and semantic\ninterpretation.\n\nIt does not alter or reinterpret the sealed run.\n\n## Exact bindings and evidence base\n\n- Experiment repository: `E:\\qwen38-pressure-qualified-lifecycle-scout-v1`\n- Audited result commit: `e4dcd58fa554e7e36b99e6cb454803cd099d2044`\n- Live v2 freeze commit: `9d14cfc674ca307880621035c8ba20933fdbaf27`\n- V2 run:\n  `runs/2026-08-23-measured-first-fit-continuation-seed-314159-v2`\n- Donor run:\n  `runs/2026-08-23-authentic-pressure-screen-seed-271828-v0`\n\nThe row-level reconstruction uses the v2 run's:\n\n- `CALL_TRACE.json`\n- `RESULT_LEDGER.json`\n- `LIFECYCLE_EVENTS.json`\n- `FINAL_MESSAGES.json`\n- `CELL_RESULT.json`\n- per-call `LEDGER_AT_CALL_START.json`\n- per-call `VISIBILITY_AT_CALL_START.json`\n- per-call `TRANSITION.json`\n- per-call `PROMPT_RECEIPT.json`\n- per-call `assistant_content.txt`\n\nTask and evidence-obligation mappings come only from:\n\n- `task/TASK.md`\n- `task/SOURCE_CATALOG.json`\n- `task/EVALUATOR.json`\n\nThe donor calls were generated under screen seed `271828`. The separately\nauthorized continuation starts from that exact model-facing boundary and uses\nseed `314159`. Continuation calls 1–18 are absolute calls 5–22.\n\n## Global mechanical facts\n\n- The source catalog and bounded access to `S01` through `S14` remained\n  actor-visible throughout. Which bytes the actor requested and received was\n  endogenous.\n- `reopen_exact` remained available for previously visible, externalized\n  exact results.\n- The candidate was exact-resident and byte-identical at every decision:\n  58 bytes, 9 words, SHA-256\n  `b4b7c78af1e8d395a2c4ccfe0150e545c892c9835afc5d26445bda29c468fea3`.\n- No mutation, check, submission, candidate effect, or effect-uptake event\n  occurred.\n- Each receipt retained result and source identity, source path, exact observed\n  range, hashes, sizes, and an exact reopen action. Together with the permanent\n  catalog, receipts also retained coarse title/role metadata. They contained no\n  model-authored conclusion or content-bearing semantic digest.\n- The only persisted model outputs were short action objects. No reasoning\n  trace or durable model-authored interpretation exists.\n- At most three exact source-result bodies were resident together at a\n  continuation call start.\n\nNotation in the tables abbreviates split sources: for example, `S03a` means\nlines 1–240 and `S03b` means lines 241–312. `R#` in the receipts column is the\nnumber of external-result receipts resident at the call start. Relief occurs\nafter the listed action, while constructing the next selected packet.\n\n## Donor prefix\n\n| Absolute call | Prompt tokens | Newly visible / exact bodies at start | Literal action | Next-packet consequence |\n|---:|---:|---|---|---|\n| 1 | 3,832 | none / none | read `S01` lines 1–94 | Exact result fits; next prompt is 5,889 tokens. |\n| 2 | 5,889 | `S01` / `S01` | read `S02` lines 1–235 | Exact result fits; next prompt is 14,034 tokens. |\n| 3 | 14,034 | `S02` / `S01`, `S02` | attempt `S03` lines 1–312 | Rejected because the 312-line request exceeds the 240-line limit; exact rejection enters call 4. |\n| 4 | 14,172 | call-3 rejection / `S01`, `S02` | read `S03a` | Ordinary next prompt is 21,442 tokens, 450 above the 20,992-token allowance. Externalize `RESULT-001` / `S01`; the selected first-fit packet is 19,818 tokens. The later v2 authorization supplies 18 continuation decisions. |\n\n## Seed-314159 v2 continuation geometry<|im_end|>\n<|im_start|>assistant\n<think>\n\n</think>\n\n","has_new_line":false,"truncated":false,"stop_type":"eos","stopping_word":"","tokens_cached":17470,"timings":{"cache_n":14591,"prompt_n":2833,"prompt_ms":4053.299,"prompt_per_token_ms":1.4307444405224143,"prompt_per_second":698.9368413235737,"predicted_n":47,"predicted_ms":1681.458,"predicted_per_token_ms":36.5534347826087,"predicted_per_second":27.35721023064507}},"timings":{"cache_n":14591,"prompt_n":2833,"prompt_ms":4053.299,"prompt_per_token_ms":1.4307444405224143,"prompt_per_second":698.9368413235737,"predicted_n":47,"predicted_ms":1681.458,"predicted_per_token_ms":36.5534347826087,"predicted_per_second":27.35721023064507}}