e\":1},{\"end_line\":70,\"source_id\":\"S03\",\"start_line\":1}] }<|im_end|>\n<|im_start|>user\n{\"delivery_ordinal\":10,\"exact_result_sha256\":\"d7c50d46c4701ad87e7d21f3b7a417342a8e931dd8c940b1f972bc3992e9466b\",\"exact_result_size_bytes\":9135,\"object_id\":\"batch:S02:1-70+S03:1-70\",\"object_version\":\"0abe527c347b897e78e1aa751fd9f8f9c9ed1bb86ecb8a1f0d2b762e1889420a\",\"observed_ranges\":[{\"end_line\":70,\"source_id\":\"S02\",\"start_line\":1},{\"end_line\":70,\"source_id\":\"S03\",\"start_line\":1}],\"previously_model_visible\":true,\"reopen_action\":{\"action\":\"reopen_exact\",\"result_id\":\"RESULT-009\"},\"reopen_handle\":\"result://sha256/d7c50d46c4701ad87e7d21f3b7a417342a8e931dd8c940b1f972bc3992e9466b\",\"resident\":false,\"result_id\":\"RESULT-009\",\"result_kind\":\"source_observation\",\"schema_version\":\"ceiba-exact-result-receipt-v1\",\"source_id\":null,\"source_ids\":[\"S02\",\"S03\"],\"source_path\":null,\"source_sha256\":null,\"source_size_bytes\":null,\"total_source_bytes\":8646}<|im_end|>\n<|im_start|>user\n{\"accepted\":false,\"configuration_id\":\"D0_DETACHED\",\"finish_reason\":\"stop\",\"input_result_id\":\"RESULT-006\",\"output_sha256\":\"faed56bd6a48681792bc6fd0101121e6a06e49d58a39ac4b16f3336b85e326c5\",\"schema\":\"artifact-coupled-maintenance-rejection-v0\",\"validation_code\":\"token_budget_exceeded\"}<|im_end|>\n<|im_start|>assistant\n{\"action\":\"read_batch\",\"requests\":[{\"end_line\":70,\"source_id\":\"S04\",\"start_line\":1},{\"end_line\":70,\"source_id\":\"S05\",\"start_line\":1}] }<|im_end|>\n<|im_start|>user\n{\"object_id\":\"batch:S04:1-70+S05:1-70\",\"object_version\":\"eadb5485b21d46fde16b344032d79a1b14aae9837dc932b2c2876cbc81e5d8ab\",\"result_id\":\"RESULT-010\",\"result_kind\":\"source_observation\",\"schema\":\"ceiba-action-result-v1\"}\n--- exact result body ---\n{\"schema\":\"architecture-batch-observation-v0\",\"segments\":[{\"end_line\":70,\"source_id\":\"S04\",\"start_line\":1},{\"end_line\":70,\"source_id\":\"S05\",\"start_line\":1}],\"total_source_bytes\":9568}\n--- exact batch segment 1 ---\n{\"end_line\":70,\"source_id\":\"S04\",\"source_path\":\"cedar_sources/S04_ROAD_NETWORK.md\",\"source_sha256\":\"c3c673a02683a15b924b29c264ede1b74f1fa0c6fd47f8e7361cd3320f9a99b0\",\"source_size_bytes\":4623,\"start_line\":1}\n--- exact source range ---\n# Road network capacity, shared bottlenecks, and contraflow\n\n## Frozen findings\n\nNorth Bridge is rated at 1,100 passenger vehicles per hour and South Pass at 850, but both feed Mill Junction, whose measured sustainable throughput is 1,500 vehicles per hour. Their headline capacities therefore cannot be added.\nNorth Bridge excludes full-size buses after deck temperature reaches 54 C until an engineer clears it. South Pass can close under smoke visibility below 150 meters. County 12 is the freight and emergency-access route and cannot be fully converted to outbound traffic.\nContraflow requires a sheriff closure order, forty-five minutes of setup, and staffed crossover points. The last exercise achieved only 1,180 vehicles per hour at Mill Junction because lane merging was unmanaged.\n\n## Governing relationships\n\nZone sequencing must reserve emergency inbound capacity and align bus routes with bridge restrictions from S05. Forecast and air-quality conditions can invalidate a route after the plan is checked.\nClearance time must use the shared junction and exercise throughput until a current field test proves a higher candidate-bound value.\n\n## Operational evidence\n\n| record | route | rated veh/h | observed veh/h | coupling | status |\n|---|---|---|---|---|---|\n| ROAD-000 | North-Bridge | 1100 | 748 | shared-junction | hold |\n| ROAD-001 | South-Pass | 850 | 607 | shared-junction | open |\n| ROAD-002 | County-12 | 620 | 465 | shared-junction | open |\n| ROAD-003 | Ridge-Connector | 480 | 376 | shared-junction | open |\n| ROAD-004 | Mill-Junction | 1500 | 1230 | system-bottleneck | open |\n| ROAD-005 | North-Bridge | 1100 | 940 | shared-junction | open |\n| ROAD-006 | South-Pass | 850 | 756 | shared-junction | open |\n| ROAD-007 | County-12 | 620 | 421 | shared-junction | open |\n| ROAD-008 | Ridge-Connector | 480 | 343 | shared-junction | open |\n| ROAD-009 | Mill-Junction | 1500 | 1125 | system-bottleneck | open |\n| ROAD-010 | North-Bridge | 1100 | 863 | shared-junction | open |\n| ROAD-011 | South-Pass | 850 | 697 | shared-junction | open |\n| ROAD-012 | County-12 | 620 | 530 | shared-junction | open |\n| ROAD-013 | Ridge-Connector | 480 | 427 | shared-junction | hold |\n| ROAD-014 | Mill-Junction | 1500 | 1020 | system-bottleneck | open |\n| ROAD-015 | North-Bridge | 1100 | 786 | shared-junction | open |\n| ROAD-016 | South-Pass | 850 | 637 | shared-junction | open |\n| ROAD-017 | County-12 | 620 | 486 | shared-junction | open |\n| ROAD-018 | Ridge-Connector | 480 | 393 | shared-junction | open |\n| ROAD-019 | Mill-Junction | 1500 | 1282 | system-bottleneck | open |\n| ROAD-020 | North-Bridge | 1100 | 979 | shared-junction | open |\n| ROAD-021 | South-Pass | 850 | 578 | shared-junction | open |\n| ROAD-022 | County-12 | 620 | 443 | shared-junction | open |\n| ROAD-023 | Ridge-Connector | 480 | 360 | shared-junction | open |\n| ROAD-024 | Mill-Junction | 1500 | 1177 | system-bottleneck | open |\n| ROAD-025 | North-Bridge | 1100 | 902 | shared-junction | open |\n| ROAD-026 | South-Pass | 850 | 726 | shared-junction | hold |\n| ROAD-027 | County-12 | 620 | 551 | shared-junction | open |\n| ROAD-028 | Ridge-Connector | 480 | 326 | shared-junction | open |\n| ROAD-029 | Mill-Junction | 1500 | 1072 | system-bottleneck | open |\n| ROAD-030 | North-Bridge | 1100 | 825 | shared-junction | open |\n| ROAD-031 | South-Pass | 850 | 667 | shared-junction | open |\n| ROAD-032 | County-12 | 620 | 508 | shared-junction | open |\n| ROAD-033 | Ridge-Connector | 480 | 410 | shared-junction | open |\n| ROAD-034 | Mill-Junction | 1500 | 1335 | system-bottleneck | open |\n| ROAD-035 | North-Bridge | 1100 | 748 | shared-junction | open |\n| ROAD-036 | South-Pass | 850 | 607 | shared-junction | open |\n| ROAD-037 | County-12 | 620 | 465 | shared-junction | open |\n| ROAD-038 | Ridge-Connector | 480 | 376 | shared-junction | open |\n| ROAD-039 | Mill-Junction | 1500 | 1230 | system-bottleneck | hold |\n| ROAD-040 | North-Bridge | 1100 | 940 | shared-junction | open |\n| ROAD-041 | South-Pass | 850 | 756 | shared-junction | open |\n| ROAD-042 | County-12 | 620 | 421 | shared-junction | open |\n| ROAD-043 | Ridge-Connector | 480 | 343 | shared-junction | open |\n| ROAD-044 | Mill-Junction | 1500 | 1125 | system-bottleneck | open |\n| ROAD-045 | North-Bridge | 1100 | 863 | shared-junction | open |\n| ROAD-046 | South-Pass | 850 | 697 | shared-junction | open |\n| ROAD-047 | County-12 | 620 | 530 | shared-junction | open |\n\n## Decision constraints\n\nDo not sum independent road ratings across a shared downstream bottleneck.\nName setup effects, route-loss contingencies, and the observation that authorizes each switch.\n--- exact batch segment 2 ---\n{\"end_line\":70,\"source_id\":\"S05\",\"source_path\":\"cedar_sources/S05_TRANSPORT_FLEET.md\",\"source_sha256\":\"f9de260d4aff0081cb42bae7f938fc4fa8b26a8c653c5cdb8b57c81527057396\",\"source_size_bytes\":4476,\"start_line\":1}\n--- exact source range ---\n# Evacuation fleet, accessible transport, and driver limits\n\n## Frozen findings\n\nEighteen county buses exist, but only eleven qualified drivers can report within two hours. Four buses are lift-equipped; each carries two occupied wheelchairs and thirty-four seated riders in that configuration.\nTwelve school buses become available at 14:30, after student release. They cannot be assumed in an earlier Zone A clearance. Ambulances are reserved for clinical need and are not general mobility vehicles.\nDrivers have a twelve-hour duty ceiling. A route plan that uses every driver for outbound movement leaves no legal return, relief, or shelter-transfer capacity.\n\n## Governing relationships\n\nThe no-vehicle and accessibility demand in S03 must be matched to actual vehicle/driver pairs. S04 bridge restrictions can remove standard buses from the fastest route.\nFuel endurance and delayed resupply in S09 constrain repeated cycles; nominal seats are not the same as sustained evacuation throughput.\n\n## Operational evidence\n\n| record | vehicle | available | seats | drivers | cycle | status |\n|---|---|---|---|---|---|---|\n| FLEET-000 | standard-bus | 1 | 44 | 1 drivers | 35m | roster-gap |\n| FLEET-001 | lift-bus | 2 | 34 | 2 drivers | 48m | qualified |\n| FLEET-002 | ambulance | 3 | 2 | 3 drivers | 61m | qualified |\n| FLEET-003 | paratransit | 4 | 8 | 4 drivers | 74m | qualified |\n| FLEET-004 | school-bus | 1 | 48 | 5 drivers | 87m | qualified |\n| FLEET-005 | standard-bus | 2 | 44 | 1 drivers | 39m | qualified |\n| FLEET-006 | lift-bus | 3 | 34 | 2 drivers | 52m | qualified |\n| FLEET-007 | ambulance | 4 | 2 | 3 drivers | 65m | qualified |\n| FLEET-008 | paratransit | 1 | 8 | 4 drivers | 78m | roster-gap |\n| FLEET-009 | school-bus | 2 | 48 | 5 drivers | 91m | qualified |\n| FLEET-010 | standard-bus | 3 | 44 | 1 drivers | 43m | qualified |\n| FLEET-011 | lift-bus | 4 | 34 | 2 drivers | 56m | qualified |\n| FLEET-012 | ambulance | 1 | 2 | 3 drivers | 69m | qualified |\n| FLEET-013 | paratransit | 2 | 8 | 4 drivers | 82m | qualified |\n| FLEET-014 | school-bus | 3 | 48 | 5 drivers | 95m | qualified |\n| FLEET-015 | standard-bus | 4 | 44 | 1 drivers | 47m | qualified |\n| FLEET-016 | lift-bus | 1 | 34 | 2 drivers | 60m | roster-gap |\n| FLEET-017 | ambulance | 2 | 2 | 3 drivers | 73m | qualified |\n| FLEET-018 | paratransit | 3 | 8 | 4 drivers | 86m | qualified |\n| FLEET-019 | school-bus | 4 | 48 | 5 drivers | 38m | qualified |\n| FLEET-020 | standard-bus | 1 | 44 | 1 drivers | 51m | qualified |\n| FLEET-021 | lift-bus | 2 | 34 | 2 drivers | 64m | qualified |\n| FLEET-022 | ambulance | 3 | 2 | 3 drivers | 77m | qualified |\n| FLEET-023 | paratransit | 4 | 8 | 4 drivers | 90m | qualified |\n| FLEET-024 | school-bus | 1 | 48 | 5 drivers | 42m | roster-gap |\n| FLEET-025 | standard-bus | 2 | 44 | 1 drivers | 55m | qualified |\n| FLEET-026 | lift-bus | 3 | 34 | 2 drivers | 68m | qualified |\n| FLEET-027 | ambulance | 4 | 2 | 3 drivers | 81m | qualified |\n| FLEET-028 | paratransit | 1 | 8 | 4 drivers | 94m | qualified |\n| FLEET-029 | school-bus | 2 | 48 | 5 drivers | 46m | qualified |\n| FLEET-030 | standard-bus | 3 | 44 | 1 drivers | 59m | qualified |\n| FLEET-031 | lift-bus | 4 | 34 | 2 drivers | 72m | qualified |\n| FLEET-032 | ambulance | 1 | 2 | 3 drivers | 85m | roster-gap |\n| FLEET-033 | paratransit | 2 | 8 | 4 drivers | 37m | qualified |\n| FLEET-034 | school-bus | 3 | 48 | 5 drivers | 50m | qualified |\n| FLEET-035 | standard-bus | 4 | 44 | 1 drivers | 63m | qualified |\n| FLEET-036 | lift-bus | 1 | 34 | 2 drivers | 76m | qualified |\n| FLEET-037 | ambulance | 2 | 2 | 3 drivers | 89m | qualified |\n| FLEET-038 | paratransit | 3 | 8 | 4 drivers | 41m | qualified |\n| FLEET-039 | school-bus | 4 | 48 | 5 drivers | 54m | qualified |\n| FLEET-040 | standard-bus | 1 | 44 | 1 drivers | 67m | roster-gap |\n| FLEET-041 | lift-bus | 2 | 34 | 2 drivers | 80m | qualified |\n| FLEET-042 | ambulance | 3 | 2 | 3 drivers | 93m | qualified |\n| FLEET-043 | paratransit | 4 | 8 | 4 drivers | 45m | qualified |\n| FLEET-044 | school-bus | 1 | 48 | 5 drivers | 58m | qualified |\n| FLEET-045 | standard-bus | 2 | 44 | 1 drivers | 71m | qualified |\n| FLEET-046 | lift-bus | 3 | 34 | 2 drivers | 84m | qualified |\n| FLEET-047 | ambulance | 4 | 2 | 3 drivers | 36m | qualified |\n\n## Decision constraints\n\nReserve accessible capacity first, state cycle times, and preserve relief-driver capacity.\nDo not count unavailable school buses or unstaffed vehicles as operational capacity.<|im_end|>\n<|im_start|>user\n{\"accepted\":false,\"configuration_id\":\"D0_DETACHED\",\"finish_reason\":\"length\",\"input_result_id\":\"RESULT-007\",\"output_sha256\":\"bb7f667f2503d79a844fdcadef7d0496590333ecc54a4b7a5f4354e071629d72\",\"schema\":\"artifact-coupled-maintenance-rejection-v0\",\"validation_code\":\"token_budget_exceeded\"}<|im_end|>\n<|im_start|>assistant\n{\"action\":\"read_batch\",\"requests\":[{\"end_line\":70,\"source_id\":\"S06\",\"start_line\":1},{\"end_line\":70,\"source_id\":\"S07\",\"start_line\":1}] }<|im_end|>\n<|im_start|>user\n{\"object_id\":\"batch:S06:1-70+S07:1-70\",\"object_version\":\"06db11200c2356f64157c9ff611c2679bdc12aeff79d9c9d867c7076c994764f\",\"result_id\":\"RESULT-011\",\"result_kind\":\"source_observation\",\"schema\":\"ceiba-action-result-v1\"}\n--- exact result body ---\n{\"schema\":\"architecture-batch-observation-v0\",\"segments\":[{\"end_line\":70,\"source_id\":\"S06\",\"start_line\":1},{\"end_line\":70,\"source_id\":\"S07\",\"start_line\":1}],\"total_source_bytes\":9957}\n--- exact batch segment 1 ---\n{\"end_line\":70,\"source_id\":\"S06\",\"source_path\":\"cedar_sources/S06_SHELTER_CAPACITY.md\",\"source_sha256\":\"f82a8ad9d53d9bacf25c4dbcbc867304140e7bd40ae00dbae911347d6a140368\",\"source_size_bytes\":4280,\"start_line\":1}\n--- exact source range ---\n# Shelter capacity, smoke filtration, and accessibility\n\n## Frozen findings\n\nThe four sites advertise 8,200 nominal spaces, but smoke-safe staffed capacity is 5,900. Civic Arena has 48 accessible cots, Expo Hall 64, Ridge School none, and West College 32.\nExpo Hall's primary route crosses the South Pass smoke corridor. Ridge School does not accept pets and lacks backup filtration. Civic Arena's generator has sixteen hours of tested fuel.\nA shelter is usable only when staffing, filtration, backup power, sanitation, and route access are current for the same operational period. Nominal floor area is not readiness.\n\n## Governing relationships\n\nMedical accommodation from S07 and animal handling from S10 change effective capacity. Air-quality thresholds in S11 may require relocation after initial opening.\nShelter assignment must be coupled to route and transport plans; independently feasible totals can form an infeasible combined system.\n\n## Operational evidence\n\n| record | site | nominal | smoke-safe | accessible | power | status |\n|---|---|---|---|---|---|---|\n| SHEL-000 | Civic-Arena | 2200 | 1600 | 48 | 12h | filter-test-due |\n| SHEL-001 | Expo-Hall | 3000 | 2100 | 64 | 13h | verified |\n| SHEL-002 | Ridge-School | 1200 | 700 | 0 | 14h | verified |\n| SHEL-003 | West-College | 1800 | 1500 | 32 | 15h | verified |\n| SHEL-004 | Civic-Arena | 2200 | 1600 | 48 | 16h | verified |\n| SHEL-005 | Expo-Hall | 3000 | 2100 | 64 | 17h | verified |\n| SHEL-006 | Ridge-School | 1200 | 700 | 0 | 18h | verified |\n| SHEL-007 | West-College | 1800 | 1500 | 32 | 19h | verified |\n| SHEL-008 | Civic-Arena | 2200 | 1600 | 48 | 20h | verified |\n| SHEL-009 | Expo-Hall | 3000 | 2100 | 64 | 12h | verified |\n| SHEL-010 | Ridge-School | 1200 | 700 | 0 | 13h | filter-test-due |\n| SHEL-011 | West-College | 1800 | 1500 | 32 | 14h | verified |\n| SHEL-012 | Civic-Arena | 2200 | 1600 | 48 | 15h | verified |\n| SHEL-013 | Expo-Hall | 3000 | 2100 | 64 | 16h | verified |\n| SHEL-014 | Ridge-School | 1200 | 700 | 0 | 17h | verified |\n| SHEL-015 | West-College | 1800 | 1500 | 32 | 18h | verified |\n| SHEL-016 | Civic-Arena | 2200 | 1600 | 48 | 19h | verified |\n| SHEL-017 | Expo-Hall | 3000 | 2100 | 64 | 20h | verified |\n| SHEL-018 | Ridge-School | 1200 | 700 | 0 | 12h | verified |\n| SHEL-019 | West-College | 1800 | 1500 | 32 | 13h | verified |\n| SHEL-020 | Civic-Arena | 2200 | 1600 | 48 | 14h | filter-test-due |\n| SHEL-021 | Expo-Hall | 3000 | 2100 | 64 | 15h | verified |\n| SHEL-022 | Ridge-School | 1200 | 700 | 0 | 16h | verified |\n| SHEL-023 | West-College | 1800 | 1500 | 32 | 17h | verified |\n| SHEL-024 | Civic-Arena | 2200 | 1600 | 48 | 18h | verified |\n| SHEL-025 | Expo-Hall | 3000 | 2100 | 64 | 19h | verified |\n| SHEL-026 | Ridge-School | 1200 | 700 | 0 | 20h | verified |\n| SHEL-027 | West-College | 1800 | 1500 | 32 | 12h | verified |\n| SHEL-028 | Civic-Arena | 2200 | 1600 | 48 | 13h | verified |\n| SHEL-029 | Expo-Hall | 3000 | 2100 | 64 | 14h | verified |\n| SHEL-030 | Ridge-School | 1200 | 700 | 0 | 15h | filter-test-due |\n| SHEL-031 | West-College | 1800 | 1500 | 32 | 16h | verified |\n| SHEL-032 | Civic-Arena | 2200 | 1600 | 48 | 17h | verified |\n| SHEL-033 | Expo-Hall | 3000 | 2100 | 64 | 18h | verified |\n| SHEL-034 | Ridge-School | 1200 | 700 | 0 | 19h | verified |\n| SHEL-035 | West-College | 1800 | 1500 | 32 | 20h | verified |\n| SHEL-036 | Civic-Arena | 2200 | 1600 | 48 | 12h | verified |\n| SHEL-037 | Expo-Hall | 3000 | 2100 | 64 | 13h | verified |\n| SHEL-038 | Ridge-School | 1200 | 700 | 0 | 14h | verified |\n| SHEL-039 | West-College | 1800 | 1500 | 32 | 15h | verified |\n| SHEL-040 | Civic-Arena | 2200 | 1600 | 48 | 16h | filter-test-due |\n| SHEL-041 | Expo-Hall | 3000 | 2100 | 64 | 17h | verified |\n| SHEL-042 | Ridge-School | 1200 | 700 | 0 | 18h | verified |\n| SHEL-043 | West-College | 1800 | 1500 | 32 | 19h | verified |\n| SHEL-044 | Civic-Arena | 2200 | 1600 | 48 | 20h | verified |\n| SHEL-045 | Expo-Hall | 3000 | 2100 | 64 | 12h | verified |\n| SHEL-046 | Ridge-School | 1200 | 700 | 0 | 13h | verified |\n| SHEL-047 | West-College | 1800 | 1500 | 32 | 14h | verified |\n\n## Decision constraints\n\nUse smoke-safe and accessible capacity, not the 8,200-space headline.\nIdentify relocation triggers and a destination for every vulnerable cohort.\n--- exact batch segment 2 ---\n{\"end_line\":70,\"source_id\":\"S07\",\"source_path\":\"cedar_sources/S07_MEDICAL_ACCESS.md\",\"source_sha256\":\"beaa9d04f58a2c793b0f2f848540ba0622d24734e6db59ceb2e66dba53ed634b\",\"source_size_bytes\":5205,\"start_line\":1}\n--- exact source range ---\n# Medical continuity and accessibility matching\n\n## Frozen findings\n\nSeventy-three residents use continuous oxygen, twenty-eight have dialysis due within twenty-four hours, and fourteen medications require refrigeration. The lists overlap and contain seven duplicate household records.\nCedar Hospital can accept twenty-two oxygen-dependent evacuees, North Clinic thirty-seven, and verified home oxygen kits cover twenty more. Those capacities total seventy-nine only if transport, power, and patient matching all pass.\nA generic shelter cot is not a medical placement. Public health must bind each high-acuity person to transport, destination, power, medication custody, and handoff confirmation.\n\n## Governing relationships\n\nS03 defines uncertain demand, S05 constrains accessible vehicles, S06 constrains destinations, and S09 constrains power/fuel. The medical plan is a joined assignment rather than four independent capacity claims.\nPublic status messages may not expose health needs; the private roster rules in S12 govern matching and deletion.\n\n## Operational evidence\n\n| record | zone | need | people | pickup ETA | match | roster |\n|---|---|---|---|---|---|---|\n| CARE-000 | A-North | oxygen | 2 | 20m | transport-unassigned | health-roster-r5 |\n| CARE-001 | A-River | dialysis | 9 | 37m | matched | health-roster-r5 |\n| CARE-002 | B-East | refrigerated-medication | 16 | 54m | matched | health-roster-r5 |\n| CARE-003 | B-Center | wheelchair | 23 | 71m | matched | health-roster-r5 |\n| CARE-004 | C-South | behavioral-support | 6 | 88m | matched | health-roster-r5 |\n| CARE-005 | C-Ridge | oxygen | 13 | 30m | matched | health-roster-r5 |\n| CARE-006 | A-North | dialysis | 20 | 47m | matched | health-roster-r5 |\n| CARE-007 | A-River | refrigerated-medication | 3 | 64m | matched | health-roster-r5 |\n| CARE-008 | B-East | wheelchair | 10 | 81m | matched | health-roster-r5 |\n| CARE-009 | B-Center | behavioral-support | 17 | 23m | transport-unassigned | health-roster-r5 |\n| CARE-010 | C-South | oxygen | 24 | 40m | matched | health-roster-r5 |\n| CARE-011 | C-Ridge | dialysis | 7 | 57m | matched | health-roster-r5 |\n| CARE-012 | A