| minimum-necessary | 16d | operational | complete |\n| DATA-034 | reunification-contact | minimum-necessary | 17d | operational | complete |\n| DATA-035 | household-status | minimum-necessary | 18d | operational | complete |\n| DATA-036 | medical-accommodation | minimum-necessary | 19d | restricted | deletion-proof-missing |\n| DATA-037 | transport-assignment | minimum-necessary | 20d | operational | complete |\n| DATA-038 | shelter-checkin | minimum-necessary | 21d | operational | complete |\n| DATA-039 | reunification-contact | minimum-necessary | 22d | operational | complete |\n| DATA-040 | household-status | minimum-necessary | 23d | operational | complete |\n| DATA-041 | medical-accommodation | minimum-necessary | 24d | restricted | complete |\n| DATA-042 | transport-assignment | minimum-necessary | 25d | operational | complete |\n| DATA-043 | shelter-checkin | minimum-necessary | 26d | operational | complete |\n| DATA-044 | reunification-contact | minimum-necessary | 27d | operational | complete |\n| DATA-045 | household-status | minimum-necessary | 28d | operational | complete |\n| DATA-046 | medical-accommodation | minimum-necessary | 29d | restricted | complete |\n| DATA-047 | transport-assignment | minimum-necessary | 30d | operational | complete |\n\n## Decision constraints\n\nSpecify minimum fields, access roles, reconciliation, deletion proof, and public/private separation.\nDo not equate shelter check-in with complete zone accountability.<|im_end|>\n<|im_start|>assistant\n<think>\n\n</think>\n\n","has_new_line":true,"truncated":false,"stop_type":"eos","stopping_word":"","tokens_cached":7862,"timings":{"cache_n":0,"prompt_n":5975,"prompt_ms":7533.553,"prompt_per_token_ms":1.260845690376569,"prompt_per_second":793.118466147381,"predicted_n":1888,"predicted_ms":65878.982,"predicted_per_token_ms":34.91202013778484,"predicted_per_second":28.643429857492333}},"timings":{"cache_n":0,"prompt_n":5975,"prompt_ms":7533.553,"prompt_per_token_ms":1.260845690376569