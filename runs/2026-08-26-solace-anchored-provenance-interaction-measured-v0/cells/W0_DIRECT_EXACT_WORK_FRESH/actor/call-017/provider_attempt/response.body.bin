on-kv ::= \"\\\"action\\\"\" space \":\" space response-format-4-action\nresponse-format-4-body ::= \"\\\"\" char+ \"\\\"\"\nresponse-format-4-body-kv ::= \"\\\"body\\\"\" space \":\" space response-format-4-body\nresponse-format-4-heading ::= (\"\\\"Authority, scope, and restoration decision\\\"\" | \"\\\"Hydraulics, storage, and zone sequencing\\\"\" | \"\\\"Sampling, source water, and treatment barriers\\\"\" | \"\\\"Power, pumping, logistics, and demand stages\\\"\" | \"\\\"Security, telemetry, and evidence custody\\\"\" | \"\\\"Public health, environmental, and communication continuity\\\"\" | \"\\\"Execution, rollback, and contingencies\\\"\" | \"\\\"Verification, blockers, falsifiers, and closure\\\"\")\nresponse-format-4-heading-kv ::= \"\\\"heading\\\"\" space \":\" space response-format-4-heading\nresponse-format-5 ::= \"{\" space response-format-5-action-kv \",\" space response-format-5-content-kv space \"}\"\nresponse-format-5-action ::= \"\\\"replace_decision\\\"\"\nresponse-format-5-action-kv ::= \"\\\"action\\\"\" space \":\" space response-format-5-action\nresponse-format-5-content ::= \"\\\"\" char+ \"\\\"\"\nresponse-format-5-content-kv ::= \"\\\"content\\\"\" space \":\" space response-format-5-content\nresponse-format-6 ::= \"{\" space response-format-6-action-kv space \"}\"\nresponse-format-6-action ::= \"\\\"run_check\\\"\"\nresponse-format-6-action-kv ::= \"\\\"action\\\"\" space \":\" space response-format-6-action\nresponse-format-7 ::= \"{\" space response-format-7-action-kv space \"}\"\nresponse-format-7-action ::= \"\\\"submit\\\"\"\nresponse-format-7-action-kv ::= \"\\\"action\\\"\" space \":\" space response-format-7-action\nroot ::= \"<|im_start|>assistant\\n\" (\"<think>\" space until-5 (\"</think>\" | ))? space response-format\nspace ::= | \" \" | \"\\n\"{1,2} [ \\t]{0,20}\nuntil-5 ::= | [<] until-5-01 | [^<] until-5\nuntil-5-01 ::= | [<] until-5-01 | [/] until-5-02 | [t] until-5-09 | [^/<t] until-5\nuntil-5-02 ::= | [<] until-5-01 | [t] until-5-03 | [^<t] until-5\nuntil-5-03 ::= | [<] until-5-01 | [h] until-5-04 | [^<h] until-5\nuntil-5-04 ::= | [<] until-5-01 | [i] until-5-05 | [^<i] until-5\nuntil-5-05 ::= | [<] until-5-01 | [n] until-5-06 | [^<n] until-5\nuntil-5-06 ::= | [<] until-5-01 | [k] until-5-07 | [^<k] until-5\nuntil-5-07 ::= | [<] until-5-01 | [^<>] until-5\nuntil-5-09 ::= | [<] until-5-01 | [o] until-5-10 | [^<o] until-5\nuntil-5-10 ::= | [<] until-5-01 | [o] until-5-11 | [^<o] until-5\nuntil-5-11 ::= | [<] until-5-01 | [l] until-5-12 | [^<l] until-5\nuntil-5-12 ::= | [<] until-5-01 | [_] until-5-13 | [^<_] until-5\nuntil-5-13 ::= | [<] until-5-01 | [c] until-5-14 | [^<c] until-5\nuntil-5-14 ::= | [<] until-5-01 | [a] until-5-15 | [^<a] until-5\nuntil-5-15 ::= | [<] until-5-01 | [l] until-5-16 | [^<l] until-5\nuntil-5-16 ::= | [<] until-5-01 | [l] until-5-17 | [^<l] until-5\nuntil-5-17 ::= | [<] until-5-01 | [^<>] until-5\n","grammar_lazy":false,"grammar_triggers":[],"preserved_tokens":[248058,248059,248068,248069],"chat_format":"peg-native","reasoning_format":"deepseek","reasoning_in_content":false,"generation_prompt":"<|im_start|>assistant\n<think>\n\n</think>\n\n","samplers":["penalties","dry","top_n_sigma","top_k","typ_p","top_p","min_p","xtc","temperature"],"speculative.types":"none","timings_per_token":false,"post_sampling_probs":false,"backend_sampling":false,"lora":[]},"prompt":"<|im_start|>system\nYou are the ordinary actor responsible for exact task work in a bounded context. Use only declared actions. Exact sources, candidates, observations, effects, and checks are externally custodied and reopenable. Semantic residue, when present, is lossy, incomplete, non-authoritative, and never a substitute for exact verification or independent readiness. Return exactly one action object per decision.<|im_end|>\n<|im_start|>user\n# Authoritative task — Solace regional-water recovery decision\n\nSolace County must restore a regional drinking-water network after wildfire,\npower, treatment, hydraulic, and control-system disturbances. Build and maintain\nthe exact candidate files, then propose submission only when the package is\ngenuinely ready for independent review.\n\nThe world contains fourteen exact, versioned source objects with opaque IDs.\nCatalog titles help navigation but do not supply findings. Read the bytes needed\nfor the work and cite sources as `[SOURCE_ID]`.\n\n## Required exact work\n\nMaintain `EVIDENCE_INTEGRATION_LEDGER.md` as a compact task-native evidence and\ndecision matrix. Preserve source-bound facts, cross-source dependencies,\nconflicts, unknowns, candidate currency, and citations. This exact artifact is\nnon-authoritative but may carry cumulative work across context turnover.\n\nConstruct `BOUNDED_AGENT_ARCHITECTURE_DECISION.md` as a 1,500–2,100-word Solace\nWater Recovery Decision with exactly the declared section headings. Use at\nleast eleven distinct source IDs and integrate—not merely list—the governing\nrelationships.\n\nAddress all twelve requirement groups:\n\n- Q01 — incident, utility, public-health, communication, and closure authority;\n- Q02 — pressure, storage, isolation, residence time, and candidate-bound hydraulics;\n- Q03 — sampling rounds, spacing, detection limits, action thresholds, and staleness;\n- Q04 — pump capacity, shared-main limits, staged demand, and current evidence;\n- Q05 — grid, generator, fuel, staffing, chemicals, and resource contingencies;\n- Q06 — treatment barriers, turbidity, disinfectant, source blend, and contact time;\n- Q07 — contamination hypotheses, observations, locations, investigation holds, and falsifiers;\n- Q08 — access, token and key state, immutable custody, retention, and automation restoration;\n- Q09 — telemetry coverage, warnings versus actions, delays, alternates, and uncertainty;\n- Q10 — environmental determination, notice clock, permits, discharge, and evidence custody;\n- Q11 — public advisories, accessibility, alternate water, service states, and communications;\n- Q12 — candidate lineage, rollback, effect uptake, current checks, blockers, independent readiness, and closure.\n\n## Relationship rules\n\nPreserve psi versus kPa, gallons versus treated reserve, micrograms versus\nmilligrams, reporting limits versus action thresholds, percentages versus\nmeasured concentration, rated versus usable power, nameplate versus shared\ncapacity, warnings versus isolation triggers, forecast versus observation, and\nmechanical checks versus public-health and independent readiness. Candidate,\nhydraulic, sampling, treatment, pump, power, key, role, telemetry, or source-\nwater changes can make earlier evidence stale.\n\nThe decision must state owners, inputs, resources, timing, dependencies,\neffects, observations, contingencies, rollback and retirement conditions, and\nevidence that would falsify important claims. Do not infer that a provenance\nrecord, mutation, green check, or submission establishes readiness.<|im_end|>\n<|im_start|>user\n# Action contract\n\nReturn exactly one JSON object using one currently allowed action.\n\n```text\n{\"action\":\"read_source\",\"source_id\":\"AURORA\",\"start_line\":1,\"end_line\":64}\n{\"action\":\"read_batch\",\"requests\":[{\"source_id\":\"AURORA\",\"start_line\":1,\"end_line\":64},{\"source_id\":\"BASTION\",\"start_line\":1,\"end_line\":64}]}\n{\"action\":\"reopen_exact\",\"result_id\":\"RESULT-001\"}\n{\"action\":\"replace_evidence_ledger\",\"content\":\"complete compact task-native matrix\"}\n{\"action\":\"upsert_decision_section\",\"heading\":\"Authority, scope, and restoration decision\",\"body\":\"exact section body\"}\n{\"action\":\"replace_decision\",\"content\":\"complete exact decision\"}\n{\"action\":\"run_check\"}\n{\"action\":\"submit\"}\n```\n\nOne read may contain at most 120 lines. One batch may contain one or two ranges,\nat most 160 total lines, 12,000 source bytes, and 6,500 model-visible result\ntokens. Same-source ranges may not overlap. Use exact catalog IDs and in-range\nline bounds.\n\nBoth configurations have the same ordinary action surface. Treatment may\nreceive separately charged, partially admitted provenance-local records after\nexact source bodies are externalized. Those records are incomplete and non-\nauthoritative. Cross-source synthesis belongs in the exact candidate with all\nsupporting citations. Checks bind to the exact candidate; any later effect\nmakes the prior check stale. Submission never self-authorizes readiness.\n\n\n# Common pre-fork action notice\nNo semantic-maintenance output is present during pressure screening. Both future configurations share this ordinary action surface and exact task work.\n\n# Exact source catalog\n{\"schema\":\"architecture-source-catalog-v0\",\"sources\":[{\"line_count\":64,\"sha256\":\"debbe3de17dc0511fe3b9f5be920a83367c84efaedb34ef4095a9add315a0761\",\"size_bytes\":4111,\"source_id\":\"AURORA\",\"title\":\"Emergency authority and restoration accountability\"},{\"line_count\":64,\"sha256\":\"f0a85d8273e5058984554a6383d51616f2e103f141b7e268f67215b90fc7ed60\",\"size_bytes\":3483,\"source_id\":\"BASTION\",\"title\":\"Hydraulic pressure, storage, and zone isolation evidence\"},{\"line_count\":64,\"sha256\":\"6db7f6a91d666ab9e013e147aa946885080f48117bd461c8a542171378aba4cb\",\"size_bytes\":3991,\"source_id\":\"CIPHER\",\"title\":\"Laboratory sampling, detection limits, and clearance evidence\"},{\"line_count\":64,\"sha256\":\"4c3707d0d2ae07ceb2bda6d83cf6585510f5398db7c66568ba38aa3fd3f01169\",\"size_bytes\":4013,\"source_id\":\"DELTA\",\"title\":\"Pump capacity, sequencing, and cavitation constraints\"},{\"line_count\":64,\"sha256\":\"a3826feabfb2389ef861bba819d3ae178c9e9086a8f309722ba1413591ff8395\",\"size_bytes\":3565,\"source_id\":\"ECHO\",\"title\":\"Grid, generator, and fuel continuity\"},{\"line_count\":64,\"sha256\":\"62997706c361243e5d2720ccc088b53d3bcc2c64e64e6ee054d588aeac8fd8b8\",\"size_bytes\":3344,\"source_id\":\"FALCON\",\"title\":\"Treatment barriers, disinfectant, and turbidity controls\"},{\"line_count\":64,\"sha256\":\"b9451cc48b50a436eefd497a4dbf5ac4974431ad0f07f9bb79796709584ab0fb\",\"size_bytes\":3622,\"source_id\":\"GARNET\",\"title\":\"Source-water contamination hypotheses and watershed controls\"},{\"line_count\":64,\"sha256\":\"dcb5a4ce70bf47372c5a52a096e89f890c74f7be1363fd78dfaf9c6cd10536e5\",\"size_bytes\":3386,\"source_id\":\"HELIX\",\"title\":\"Access, control-system integrity, and evidence custody\"},{\"line_count\":64,\"sha256\":\"64836aa42ff09665cee35507acf1ca8f242ddb78ed4457b0e81e31a93c9c8977\",\"size_bytes\":3704,\"source_id\":\"INDIGO\",\"title\":\"Telemetry coverage, alerts, and observation quality\"},{\"line_count\":64,\"sha256\":\"feaaeb0601ea46b069dff02673e85774d86ff857def778cc48ecc0f6df706e00\",\"size_bytes\":3310,\"source_id\":\"JASPER\",\"title\":\"Environmental permits, discharge, and reporting\"},{\"line_count\":64,\"sha256\":\"2536c9c9d966266ccfecd69690d7575dcb4025b53ab52812cece766b0077c600\",\"size_bytes\":3584,\"source_id\":\"KESTREL\",\"title\":\"Fuel, chemicals, staffing, and mutual-aid logistics\"},{\"line_count\":64,\"sha256\":\"1a50bae39974b3c33c2a0a6b6b94859b75f41e3c4d4a01f17cf519db7b98253c\",\"size_bytes\":3813,\"source_id\":\"LUMEN\",\"title\":\"Public warnings, accessibility, and customer continuity\"},{\"line_count\":64,\"sha256\":\"a3836321537dc4f3ee3cacc094761d5176c0a7f08ae891f4fc4e1ee5b3f84b4d\",\"size_bytes\":3861,\"source_id\":\"MOSAIC\",\"title\":\"Candidate lineage, rollback, and configuration control\"},{\"line_count\":64,\"sha256\":\"85aabce45a9704e4f55ee1418528eb083a7c46326dbb366b0cb4a3ddcd9df0d6\",\"size_bytes\":3762,\"source_id\":\"NEXUS\",\"title\":\"Independent readiness review, blockers, and falsifiers\"}]}<|im_end|>\n<|im_start|>user\n# Exact current candidate\n{\"candidate_sha256\":\"9a228857dd50e69921af6d67c22e74bd3156dfb6266475ce63838881a822da61\",\"candidate_version\":\"candidate-v000:9a228857dd50e69921af6d67c22e74bd3156dfb6266475ce63838881a822da61\",\"files\