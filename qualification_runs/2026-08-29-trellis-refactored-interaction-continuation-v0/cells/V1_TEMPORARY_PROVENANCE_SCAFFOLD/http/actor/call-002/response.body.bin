 char+ \"\\\"\"\nresponse-format-4-body-kv ::= \"\\\"body\\\"\" space \":\" space response-format-4-body\nresponse-format-4-heading ::= (\"\\\"Authority, scope, and operating states\\\"\" | \"\\\"Heat triggers and geographic staging\\\"\" | \"\\\"Power, water, and cooling continuity\\\"\" | \"\\\"Clinical, shelter, and accessibility operations\\\"\" | \"\\\"Transit, communications, logistics, and staffing\\\"\" | \"\\\"Execution, rollback, verification, and closure\\\"\")\nresponse-format-4-heading-kv ::= \"\\\"heading\\\"\" space \":\" space response-format-4-heading\nresponse-format-5 ::= \"{\" space response-format-5-action-kv \",\" space response-format-5-edits-kv space \"}\"\nresponse-format-5-action ::= \"\\\"patch_decision\\\"\"\nresponse-format-5-action-kv ::= \"\\\"action\\\"\" space \":\" space response-format-5-action\nresponse-format-5-edits ::= \"[\" space response-format-5-edits-item (\",\" space response-format-5-edits-item){0,23} space \"]\"\nresponse-format-5-edits-item ::= \"{\" space response-format-5-edits-item-new-kv \",\" space response-format-5-edits-item-old-kv space \"}\"\nresponse-format-5-edits-item-new-kv ::= \"\\\"new\\\"\" space \":\" space string\nresponse-format-5-edits-item-old ::= \"\\\"\" char+ \"\\\"\"\nresponse-format-5-edits-item-old-kv ::= \"\\\"old\\\"\" space \":\" space response-format-5-edits-item-old\nresponse-format-5-edits-kv ::= \"\\\"edits\\\"\" space \":\" space response-format-5-edits\nresponse-format-6 ::= \"{\" space response-format-6-action-kv \",\" space response-format-6-content-kv space \"}\"\nresponse-format-6-action ::= \"\\\"replace_decision\\\"\"\nresponse-format-6-action-kv ::= \"\\\"action\\\"\" space \":\" space response-format-6-action\nresponse-format-6-content ::= \"\\\"\" char+ \"\\\"\"\nresponse-format-6-content-kv ::= \"\\\"content\\\"\" space \":\" space response-format-6-content\nresponse-format-7 ::= \"{\" space response-format-7-action-kv space \"}\"\nresponse-format-7-action ::= \"\\\"begin_verification\\\"\"\nresponse-format-7-action-kv ::= \"\\\"action\\\"\" space \":\" space response-format-7-action\nroot ::= \"<|im_start|>assistant\\n\" (\"<think>\" space until-5 (\"</think>\" | ))? space response-format\nspace ::= | \" \" | \"\\n\"{1,2} [ \\t]{0,20}\nstring ::= \"\\\"\" char* \"\\\"\"\nuntil-5 ::= | [<] until-5-01 | [^<] until-5\nuntil-5-01 ::= | [<] until-5-01 | [/] until-5-02 | [t] until-5-09 | [^/<t] until-5\nuntil-5-02 ::= | [<] until-5-01 | [t] until-5-03 | [^<t] until-5\nuntil-5-03 ::= | [<] until-5-01 | [h] until-5-04 | [^<h] until-5\nuntil-5-04 ::= | [<] until-5-01 | [i] until-5-05 | [^<i] until-5\nuntil-5-05 ::= | [<] until-5-01 | [n] until-5-06 | [^<n] until-5\nuntil-5-06 ::= | [<] until-5-01 | [k] until-5-07 | [^<k] until-5\nuntil-5-07 ::= | [<] until-5-01 | [^<>] until-5\nuntil-5-09 ::= | [<] until-5-01 | [o] until-5-10 | [^<o] until-5\nuntil-5-10 ::= | [<] until-5-01 | [o] until-5-11 | [^<o] until-5\nuntil-5-11 ::= | [<] until-5-01 | [l] until-5-12 | [^<l] until-5\nuntil-5-12 ::= | [<] until-5-01 | [_] until-5-13 | [^<_] until-5\nuntil-5-13 ::= | [<] until-5-01 | [c] until-5-14 | [^<c] until-5\nuntil-5-14 ::= | [<] until-5-01 | [a] until-5-15 | [^<a] until-5\nuntil-5-15 ::= | [<] until-5-01 | [l] until-5-16 | [^<l] until-5\nuntil-5-16 ::= | [<] until-5-01 | [l] until-5-17 | [^<l] until-5\nuntil-5-17 ::= | [<] until-5-01 | [^<>] until-5\n","grammar_lazy":false,"grammar_triggers":[],"preserved_tokens":[248058,248059,248068,248069],"chat_format":"peg-native","reasoning_format":"deepseek","reasoning_in_content":false,"generation_prompt":"<|im_start|>assistant\n<think>\n\n</think>\n\n","samplers":["penalties","dry","top_n_sigma","top_k","typ_p","top_p","min_p","xtc","temperature"],"speculative.types":"none","timings_per_token":false,"post_sampling_probs":false,"backend_sampling":false,"lora":[]},"prompt":"<|im_start|>system\nYou are the ordinary actor in a bounded urban heat-continuity system.\n\nUse exact task actions to inspect evidence, build exact task artifacts, check\nthe current candidate, repair real blockers, and propose submission only after\nthe changed candidate has a current passing check. Exact sources, effects,\nchecks, rejected actions, and history remain externally custodied.\n\nAny semantic scaffold is lossy, incomplete, non-authoritative, source-bound,\nand temporary. Use it only to help convert exact evidence into revisable exact\ntask work. It cannot authorize operations, readiness, submission, or closure.\nPreserve exact values, units, versions, qualifications, modalities, and\nauthority boundaries. Candidate mutation makes prior checks stale.\n\nReturn exactly one declared JSON action and no prose.<|im_end|>\n<|im_start|>user\n# Trellis Urban Heat Continuity Task\n\nProduce two exact, source-grounded work products for the synthetic Trellis\nurban heat emergency:\n\n1. `EVIDENCE_INTEGRATION_LEDGER.md`, beginning exactly with\n   `# Trellis Evidence-to-Requirement Matrix`.\n2. `BOUNDED_AGENT_ARCHITECTURE_DECISION.md`, beginning exactly with\n   `# Trellis Urban Heat Continuity Decision` and containing exactly these\n   ordered level-two headings:\n\n   1. `Authority, scope, and operating states`\n   2. `Heat triggers and geographic staging`\n   3. `Power, water, and cooling continuity`\n   4. `Clinical, shelter, and accessibility operations`\n   5. `Transit, communications, logistics, and staffing`\n   6. `Execution, rollback, verification, and closure`\n\nThe final decision must contain 1,200–1,650 words excluding bracketed source\ncitations and cite at least ten distinct exact source IDs. Reconcile authority,\nhazard thresholds, power, water, clinical surge, cooling-center capacity,\naccessible transit, public communication, logistics, staffing, candidate\nlineage, and independent readiness.\n\nBind each action and gate to owners, prerequisites, observations, the current\ncandidate, falsifiers, rollback, and evidence that retires temporary controls.\nPreserve observations versus gates, probability versus coverage, installed\nversus usable capacity, reserve versus flow, median versus percentile, hours\nversus days, source-local authority, and current versus stale evidence.\n\nChecks are candidate-bound mechanical feedback. They do not independently\nauthorize operations, readiness, submission, or closure.<|im_end|>\n<|im_start|>user\n# Trellis construction action contract\n\nReturn exactly one JSON action object and no prose.\n\n```text\n{\"action\":\"read_source\",\"source_id\":\"COUNCIL\",\"start_line\":1,\"end_line\":60}\n{\"action\":\"read_batch\",\"requests\":[{\"source_id\":\"COUNCIL\",\"start_line\":1,\"end_line\":60},{\"source_id\":\"CLIMATE\",\"start_line\":1,\"end_line\":60}]}\n{\"action\":\"reopen_exact\",\"result_id\":\"RESULT-001\"}\n{\"action\":\"replace_evidence_ledger\",\"content\":\"complete compact task-native evidence-to-requirement matrix\"}\n{\"action\":\"upsert_decision_section\",\"heading\":\"Authority, scope, and operating states\",\"body\":\"exact section body\"}\n{\"action\":\"patch_decision\",\"edits\":[{\"old\":\"exact unique text\",\"new\":\"replacement text\"}]}\n{\"action\":\"replace_decision\",\"content\":\"complete exact decision\"}\n{\"action\":\"begin_verification\"}\n```\n\nOne read may contain at most 120 lines. A batch may contain one or two ranges,\nat most 160 lines and 12,000 exact source bytes. Incremental ledger and section\nwork is exact, versioned task state and remains available after source bodies\nleave residency. `begin_verification` is valid only after the frozen mechanical\nconstruction milestone. It changes lifecycle phase, not candidate bytes, and\ndoes not assert readiness.\n\n\n# Common pre-fork action notice\nNo semantic-maintenance output is present during pressure screening. Both future configurations share this ordinary action surface and exact task work.\n\n# Exact source catalog\n{\"schema\":\"architecture-source-catalog-v0\",\"sources\":[{\"line_count\":94,\"sha256\":\"1dcfd09e66f004f0cf3b7849dcc7ca097d4d6135809649c33d6cb1784dac88ea\",\"size_bytes\":5794,\"source_id\":\"COUNCIL\",\"title\":\"Heat emergency authority and public operating states\"},{\"line_count\":94,\"sha256\":\"163e45cdae8f3d164079e68b4f2a1386df81616b32290eb79e51bd2ccde99ca7\",\"size_bytes\":6017,\"source_id\":\"CLIMATE\",\"title\":\"Heat index, WBGT, and geographic trigger evidence\"},{\"line_count\":94,\"sha256\":\"2149dcb753ebd817f10869d394e30f61e89ac46d6d4de2ace9bde1cb7c13299d\",\"size_bytes\":5546,\"source_id\":\"GRID\",\"title\":\"Cooling power, feeder limits, and backup capacity\"},{\"line_count\":94,\"sha256\":\"99ff010ef7c523ff6805b118fb7678a403caf6cfb047f9a7607832a51f1e4291\",\"size_bytes\":5054,\"source_id\":\"WATER\",\"title\":\"Potable water, pressure, and hydration logistics\"},{\"line_count\":94,\"sha256\":\"f8db85fe7f667c38151156fa2c5c25f3601462976e555f637ccff746c13a34b4\",\"size_bytes\":5990,\"source_id\":\"CLINIC\",\"title\":\"Clinical surge, triage, and ambulance readiness\"},{\"line_count\":94,\"sha256\":\"dcd71253d29841bf14beafb1e65b01527aa9c8dab2d65d352537ea6faec725fb\",\"size_bytes\":5949,\"source_id\":\"SHELTER\",\"title\":\"Cooling-center capacity, accessibility, and intake\"},{\"line_count\":94,\"sha256\":\"ffbd14f8f91fe0401dc7bd803384dc9fd57fc83e8cf827b06ca4820586cbbd1d\",\"size_bytes\":6022,\"source_id\":\"TRANSIT\",\"title\":\"Transit access, vehicle readiness, and route continuity\"},{\"line_count\":94,\"sha256\":\"eb7a710e40fa9c55f274159b16d44b15b18b566dadfbc0336b1f72a087244c56\",\"size_bytes\":5697,\"source_id\":\"COMMS\",\"title\":\"Public communication, confirmation, and delivery latency\"},{\"line_count\":94,\"sha256\":\"15c6064b6a18aa405d9452ce80723cfe5777c21febe01c5215ebd20c10491f4f\",\"size_bytes\":5640,\"source_id\":\"SUPPLY\",\"title\":\"Fuel, water, medical stock, and resupply\"},{\"line_count\":94,\"sha256\":\"611fd4a34cd63674cd688ee5ee798fb459efe60415670b2ae35fb6410c32905c\",\"size_bytes\":5638,\"source_id\":\"LABOR\",\"title\":\"Staff qualification, fatigue, and mutual aid\"},{\"line_count\":94,\"sha256\":\"5cede2220909ef14f1d0cf59f9abcd5bbd51e64e2348b9319c6c1cf49cd40fd5\",\"size_bytes\":5897,\"source_id\":\"LINEAGE\",\"title\":\"Operating-map lineage, rollback, and evidence currency\"},{\"line_count\":94,\"sha256\":\"bf4c6baceb91ea862cbc726d6e599b944890bc45290c758d0c0faac451fc6581\",\"size_bytes\":5819,\"source_id\":\"REVIEW\",\"title\":\"Independent readiness review and unresolved blockers\"}]}<|im_end|>\n<|im_start|>user\n# Exact current candidate\n{\"candidate_sha256\":\"2fcc44ae287280f144c38271e7303a03c0ab74fc54ce7723a229b00d3bdafe2e\",\"candidate_version\":\"candidate-v001:2fcc44ae287280f144c38271e7303a03c0ab74fc54ce7723a229b00d3bdafe2e\",\"files\":{\"BOUNDED_AGENT_ARCHITECTURE_DECISION.md\":\"213b2799a8ddafc74439b51faef4741ea3df4af52d872667ee5cc69b191ec647\",\"EVIDENCE_INTEGRATION_LEDGER.md\":\"70fb7e0cb4a61c8b182c6e6c8842c8fca4f59eacb9aaf8136e40dbb0b7c60885\"},\"schema\":\"architecture-current-candidate-v0\"}\n--- exact candidate file: EVIDENCE_INTEGRATION_LEDGER.md ---\n# Trellis Evidence-to-Requirement Matrix\n\n## Authority & Operating States\n| Req | Source | Anchor/Version | Measure | Status | Requirement |\n|---|---|---|---:|---|---|\n| AUTH-01 | COUNCIL [AUT-046] v6 | 3.8 approval | superseded | Retire temporary controls; current authority must be explicit [COUNCIL]. |\n| AUTH-02 | LINEAGE [LIN-071] v8 | T9, F6, G4, R8, L11, C7 | current | Candidate lineage must match current facility, load, route, roster, and release versions [LINEAGE]. |\n\n## Heat Triggers & Geographic Staging\n| Req | Source | Anchor/Version | Measure | Status | Requirement |\n|---|---|---|---:|---|---|\n| CLIM-01 | CLIMATE [CLI-046] v6 | 41.8 °C-WBGT | superseded | Hazard thresholds must use current WBGT evidence; superseded records are historical only [CLIMATE]. |\n\n## Power, Water & Cooling Continuity\n| Req | Source | Anchor/Version | Measure | Status | Requirement |\n|---|---|---|---:|---|---|\n| GRID-01 | GRID [GRD-071] v8 | 29.8 MW backup | current | Backup capacity must be verified against emergency cooling load [GRID]. |\n| WTR-01 | WATER [WTR-071] v8 | 39.8 psi mobile-cache | current | Pressure must meet hydration logistics; reserve vs flow distinction required [WATER]. |\n\n## Clinical, Shelter & Accessibility\n| Req | Source | Anchor/Version | Measure | Status | Requirement |\n|---|---|---|---:|---|---|\n| CLIN-01 | CLINIC [CLN-052] v7 | 72.4% occupied (hospital-a) | current | Clinical surge capacity must account for current occupancy vs installed capacity [CLINIC]. |\n| SHL-01 | SHELTER [SHL-052] v7 | 2101.4 installed seats (library-hub) | current | Cooling-center capacity must distinguish installed seats from usable intake [SHELTER]. |\n\n## Transit, Communications & Logistics\n| Req | Source | Anchor/Version | Measure | Status | Requirement |\n|---|---|---|---:|---|---|\n| TRN-01 | TRANSIT [TRN-065] v8 | 88.3% available (route-blue) | current | Transit access must maintain availability for accessible routes [TRANSIT]. |\n| TRN-02 | TRANSIT [TRN-066] v8 | 90.0% available (paratransit) | current | Paratransit coverage is a separate accessibility gate [TRANSIT]. |\n| COM-01 | COMMS [COM-071] v8 | 90.8% delivered (call-center) | current | Public communication delivery latency must be verified [COMMS]. |\n| COM-02 | COMMS [COM-070] v8 | 89.1% delivered (web) | current | Web channel delivery is a distinct communication gate [COMMS]. |\n\n## Staffing, Logistics & Readiness\n| Req | Source | Anchor/Version | Measure | Status | Requirement |\n|---|---|---|---:|---|---|\n| SUP-01 | SUPPLY [SUP-071] v8 | 17.8 hours-cover (tanker-fleet) | current | Resupply logistics must distinguish hours vs days and planned arrival vs deployed capacity [SUPPLY]. |\n| LAB-01 | LABOR [LAB-071] v8 | 10.8 hours-on-duty (interpreters) | current | Staff qualification and fatigue limits (12h on, 10h off) must be enforced [LABOR]. |\n| REV-01 | REVIEW [REV-071] v8 | 11.8 open-findings (